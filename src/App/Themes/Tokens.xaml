<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      T-053 — Design tokens for the dark + gold redesign.
      Palette source: user mockup. This dictionary defines ONLY tokens
      (colors, brushes, radii, spacing, type). Control styles live in Controls.xaml.
      Views are NOT restyled here (that is T-054).
    -->

    <!-- ============================ COLORS ============================ -->
    <Color x:Key="BgColor">#FF0D0F13</Color>          <!-- window background, near-black -->
    <Color x:Key="SurfaceColor">#FF15181E</Color>     <!-- panels / cards -->
    <Color x:Key="Surface2Color">#FF1A1E25</Color>    <!-- controls bar / secondary surface -->
    <Color x:Key="VideoBgColor">#FF000000</Color>     <!-- video area -->
    <Color x:Key="AccentColor">#FFE0A83A</Color>      <!-- GOLD primary accent -->
    <Color x:Key="AccentMutedColor">#40E0A83A</Color> <!-- accent @ ~25% opacity -->
    <Color x:Key="TextPrimaryColor">#FFEDEDED</Color> <!-- body text on dark -->
    <Color x:Key="TextMutedColor">#FF9AA0A8</Color>   <!-- labels / secondary text -->
    <Color x:Key="BorderColor">#FF2A2F38</Color>      <!-- subtle dark border -->
    <Color x:Key="DangerColor">#FFE5484D</Color>      <!-- readable red on dark -->
    <Color x:Key="OkColor">#FF3FB950</Color>          <!-- readable green on dark -->
    <Color x:Key="AccentTextColor">#FF16130A</Color>  <!-- dark text on gold accent -->

    <!-- ============================ BRUSHES ============================ -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="VideoBgBrush" Color="{StaticResource VideoBgColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />

    <!-- hover / pressed helpers (kept subtle over Surface) -->
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF20252E" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#FF10131A" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFECB94F" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FFC8912E" />

    <!-- ============================ CORNER RADII ============================ -->
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">24</CornerRadius>

    <!-- ============================ SPACING (Thickness) ============================ -->
    <sys:Double x:Key="SpaceXs">4</sys:Double>
    <sys:Double x:Key="SpaceSm">8</sys:Double>
    <sys:Double x:Key="SpaceMd">12</sys:Double>
    <sys:Double x:Key="SpaceLg">16</sys:Double>
    <sys:Double x:Key="SpaceXl">24</sys:Double>

    <Thickness x:Key="PaddingSm">8,4</Thickness>
    <Thickness x:Key="PaddingMd">12,8</Thickness>
    <Thickness x:Key="PaddingLg">16,12</Thickness>

    <!-- ============================ TYPE ============================ -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>

</ResourceDictionary>
