<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>VideoSplitJoiner.App</RootNamespace>
    <AssemblyName>VideoSplitJoiner.App</AssemblyName>

    <!-- Product / version metadata (Version comes from Directory.Build.props) -->
    <AssemblyTitle>VideoSplitJoiner</AssemblyTitle>
    <Product>VideoSplitJoiner</Product>
    <Company>VideoSplitJoiner</Company>
    <Description>Split and join video files with a bundled ffmpeg.</Description>

    <!-- App icon (placeholder — see T-010 / THIRD-PARTY-NOTICES notes) -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Packaging / publish configuration (T-010).
    Self-contained single-file win-x64. These props apply ONLY when publishing single-file
    (i.e. `dotnet publish -p:PublishSingleFile=true`), so a normal `dotnet build` / `dotnet test`
    stays a framework-dependent, multi-file build and is unaffected.
    Trimming (PublishTrimmed) is deliberately NOT enabled — trimming is unsupported and unsafe
    for WPF (reflection / XAML resource loading breaks). Do not add it.
  -->
  <PropertyGroup>
    <!-- T-132 / ADR-0019: FFME's IMediaInputStream is the ONLY way to open a file whose path cannot be
         expressed as a Uri (a network share whose server name contains a space). Its Read/Seek take raw
         pointers, so this project must allow unsafe blocks. The unsafe surface is deliberately confined to
         Media/FileMediaInputStream.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- WPF ships native libs; they must self-extract from the single-file bundle. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Faster cold start; safe for WPF (unlike trimming). -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\VideoSplitJoiner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFME.Windows" Version="7.0.361-beta.1" />
  </ItemGroup>

  <!--
    T-058 — bundle IBM Plex Mono + IBM Plex Sans (SIL OFL 1.1) as WPF Resources.
    Referenced from Themes/Tokens.xaml via pack URIs (pack://application:,,,/Fonts/#IBM Plex Mono).
    See THIRD-PARTY-NOTICES.md for attribution.
  -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <!--
    G-024 / T-067 — self-bundle ffmpeg. Copy the repo-root ffmpeg-shared/ CLI (ffmpeg.exe/ffprobe.exe)
    + its shared DLLs into an app-local ffmpeg/ folder in the build output, which is exactly where
    FfmpegBinaryLocator looks (app-local ffmpeg/ next to the assembly). This makes a plain `dotnet build`
    produce a runnable app that splits/joins WITHOUT ffmpeg on PATH — fulfilling the csproj's
    "bundled ffmpeg" promise. ffmpeg-shared/ is gitignored (populated by packaging/fetch-ffmpeg-shared.ps1);
    if it's absent (fresh clone before fetch) the target WARNS and skips rather than failing the build,
    so CI / clean checkouts still build. Publish/single-file bundling is a separate T-010 concern.
  -->
  <Target Name="CopyBundledFfmpeg" AfterTargets="Build">
    <ItemGroup>
      <FfmpegSharedFiles Include="$(MSBuildProjectDirectory)\..\..\ffmpeg-shared\*.exe;$(MSBuildProjectDirectory)\..\..\ffmpeg-shared\*.dll" />
    </ItemGroup>
    <Warning Condition="'@(FfmpegSharedFiles)' == ''"
             Text="ffmpeg-shared/ not found at repo root — app-local ffmpeg/ was NOT bundled. Run packaging/fetch-ffmpeg-shared.ps1; otherwise split/join needs ffmpeg on PATH." />
    <Copy Condition="'@(FfmpegSharedFiles)' != ''"
          SourceFiles="@(FfmpegSharedFiles)"
          DestinationFolder="$(OutDir)ffmpeg\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
