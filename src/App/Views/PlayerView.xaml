<UserControl x:Class="VideoSplitJoiner.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video surface -->
        <Border Grid.Row="0" Background="Black" MinHeight="160">
            <ffme:MediaElement x:Name="Media"
                               LoadedBehavior="Manual"
                               UnloadedBehavior="Manual"
                               ScrubbingEnabled="True"
                               Stretch="Uniform" />
        </Border>

        <!-- Scrubbable timeline -->
        <Slider Grid.Row="1"
                Margin="0,6,0,0"
                Minimum="0"
                Maximum="{Binding DurationSeconds, Mode=OneWay}"
                Value="{Binding PositionSeconds, Mode=TwoWay}"
                IsEnabled="{Binding IsReady}" />

        <!-- Transport + time readout -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    MinWidth="70"
                    Padding="10,3"
                    Content="{Binding PlayPauseLabel}"
                    Command="{Binding PlayPauseCommand}" />
            <Button Grid.Column="1"
                    Margin="6,0,0,0"
                    Padding="10,3"
                    Content="Stop"
                    Command="{Binding StopCommand}" />

            <TextBlock Grid.Column="3"
                       VerticalAlignment="Center"
                       FontFamily="Consolas">
                <Run Text="{Binding PositionText, Mode=OneWay}" />
                <Run Text=" / " />
                <Run Text="{Binding DurationText, Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <!-- Preview-unavailable banner -->
        <Border Grid.Row="3"
                Margin="0,6,0,0"
                Padding="6"
                Background="#FFF7E6"
                BorderBrush="#E8B84B"
                BorderThickness="1"
                Visibility="{Binding PreviewFailed, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Preview unavailable — you can still cut this file."
                           FontWeight="Bold"
                           Foreground="#7A5C00"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0"
                           Text="{Binding PreviewFailedReason}"
                           Foreground="#7A5C00"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
