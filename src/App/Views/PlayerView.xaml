<UserControl x:Class="VideoSplitJoiner.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:PathToBitmapConverter x:Key="PathToBitmap" />

        <!-- Compact square-ish jog button: small, tooltip-labelled, wraps at pane min width.
             Inherits the themed implicit Button (dark surface, TextPrimary, gold hover); only
             sizing/typography are overridden here. -->
        <Style x:Key="JogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video surface: black video area inside a rounded surface frame with a muted-gold border. -->
        <Border Grid.Row="0"
                MinHeight="160"
                Padding="6"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AccentMutedBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}">
            <Border Background="{StaticResource VideoBgBrush}"
                    CornerRadius="{StaticResource RadiusSm}"
                    ClipToBounds="True">
                <ffme:MediaElement x:Name="Media"
                                   LoadedBehavior="Manual"
                                   UnloadedBehavior="Manual"
                                   ScrubbingEnabled="True"
                                   Stretch="Uniform" />
            </Border>
        </Border>

        <!-- Scrubbable timeline. DragStarted/DragDelta/DragCompleted drive a LIVE scrub (T-051): the
             frame follows the pin during the drag via ScrubPreview (coalesced + throttled), and the
             final exact seek fires on release. The T-033 seek-target hold gates stale echoes.
             IsMoveToPointEnabled=True (T-075): a click on the TRACK jumps the thumb straight to the
             click point (one Value change to the clicked time) instead of page-stepping toward it, so
             a click seeks to exactly where the user clicked. The VM dedupes the click Value-change
             seek against the drag-completed seek so a click yields one converged seek, not two. -->
        <!-- Grid.Row 1 hosts the scrub slider + its hover-thumbnail popup (T-078). The popup is anchored
             to the slider and placed ABOVE it, following the cursor via HorizontalOffset (clamped in
             code-behind so it never clips off either end). MouseMove is PASSIVE — it only feeds the
             hover VM; it never handles/suppresses the click, so click-to-seek (G-028) + drag scrub
             (T-033/T-051) are untouched. -->
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Slider x:Name="ScrubSlider"
                    Minimum="0"
                    Maximum="{Binding DurationSeconds, Mode=OneWay}"
                    Value="{Binding PositionSeconds, Mode=TwoWay}"
                    IsEnabled="{Binding IsReady}"
                    IsMoveToPointEnabled="True"
                    MouseEnter="OnScrubMouseEnter"
                    MouseLeave="OnScrubMouseLeave"
                    MouseMove="OnScrubMouseMove"
                    Thumb.DragStarted="OnScrubDragStarted"
                    Thumb.DragDelta="OnScrubDragDelta"
                    Thumb.DragCompleted="OnScrubDragCompleted" />

            <!-- Hover thumbnail: dark surface card (IBM Plex tokens) with the frame image + mm:ss label,
                 floated above the bar at the cursor. StaysOpen so it never steals focus; IsHitTestVisible
                 off so it never intercepts a click through to the slider. -->
            <Popup x:Name="HoverThumbPopup"
                   PlacementTarget="{Binding ElementName=ScrubSlider}"
                   Placement="Top"
                   HorizontalOffset="{Binding Thumbnail.HoverOffsetX, Mode=OneWay}"
                   VerticalOffset="-8"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   IsHitTestVisible="False"
                   IsOpen="{Binding Thumbnail.IsThumbnailVisible, Mode=OneWay}">
                <Border Background="{StaticResource Surface0Brush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="3"
                        SnapsToDevicePixels="True">
                    <StackPanel Width="160">
                        <!-- Frame image (frozen BitmapImage via the path converter). Fixed 160-wide box;
                             90px tall (16:9) letterbox so the popup doesn't jump as frames vary. Only
                             shown once a path is available; otherwise the label alone floats. -->
                        <Border Height="90"
                                Background="{StaticResource VideoBgBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                ClipToBounds="True"
                                Visibility="{Binding Thumbnail.HasThumbnail, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding Thumbnail.HoverThumbnailPath, Converter={StaticResource PathToBitmap}}"
                                   Stretch="Uniform" />
                        </Border>

                        <TextBlock Text="{Binding Thumbnail.HoverTimeText, Mode=OneWay}"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,1"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Skip / jog / frame-step / jump-to-ends (T-028) — wraps so it stays readable at min width.
             Layout: |◄start  −5m −1m −20s −10s −5s −1s  ⏴frame  ▶/⏸  frame⏵  +1s +5s +10s +20s +1m +5m  end►| -->
        <WrapPanel Grid.Row="2" Margin="0,4,0,0" HorizontalAlignment="Center">
            <Button Style="{StaticResource JogButton}" Content="&#x25C4;&#x2759;"
                    ToolTip="Jump to start"
                    Command="{Binding JumpToStartCommand}" />

            <Button Style="{StaticResource JogButton}" Content="&#x2212;20m"
                    ToolTip="Back 20 minutes"
                    Command="{Binding SkipCommand}" CommandParameter="-1200" />
            <Button Style="{StaticResource JogButton}" Content="&#x2212;10m"
                    ToolTip="Back 10 minutes"
                    Command="{Binding SkipCommand}" CommandParameter="-600" />
            <Button Style="{StaticResource JogButton}" Content="-5m"
                    ToolTip="Back 5 minutes"
                    Command="{Binding SkipCommand}" CommandParameter="-300" />
            <Button Style="{StaticResource JogButton}" Content="-1m"
                    ToolTip="Back 1 minute"
                    Command="{Binding SkipCommand}" CommandParameter="-60" />
            <Button Style="{StaticResource JogButton}" Content="-20s"
                    ToolTip="Back 20 seconds"
                    Command="{Binding SkipCommand}" CommandParameter="-20" />
            <Button Style="{StaticResource JogButton}" Content="-10s"
                    ToolTip="Back 10 seconds"
                    Command="{Binding SkipCommand}" CommandParameter="-10" />
            <Button Style="{StaticResource JogButton}" Content="-5s"
                    ToolTip="Back 5 seconds"
                    Command="{Binding SkipCommand}" CommandParameter="-5" />
            <Button Style="{StaticResource JogButton}" Content="-1s"
                    ToolTip="Back 1 second"
                    Command="{Binding SkipCommand}" CommandParameter="-1" />

            <Button Style="{StaticResource JogButton}" Content="&#x23F4;|"
                    ToolTip="Step back one frame"
                    Command="{Binding StepBackCommand}" />

            <!-- Reused play/pause — primary transport action: gold AccentButton. -->
            <Button Style="{StaticResource AccentButton}"
                    MinWidth="60" Padding="12,2" Margin="4,0"
                    Content="{Binding PlayPauseLabel}"
                    Command="{Binding PlayPauseCommand}" />

            <Button Style="{StaticResource JogButton}" Content="|&#x23F5;"
                    ToolTip="Step forward one frame"
                    Command="{Binding StepForwardCommand}" />

            <Button Style="{StaticResource JogButton}" Content="+1s"
                    ToolTip="Forward 1 second"
                    Command="{Binding SkipCommand}" CommandParameter="1" />
            <Button Style="{StaticResource JogButton}" Content="+5s"
                    ToolTip="Forward 5 seconds"
                    Command="{Binding SkipCommand}" CommandParameter="5" />
            <Button Style="{StaticResource JogButton}" Content="+10s"
                    ToolTip="Forward 10 seconds"
                    Command="{Binding SkipCommand}" CommandParameter="10" />
            <Button Style="{StaticResource JogButton}" Content="+20s"
                    ToolTip="Forward 20 seconds"
                    Command="{Binding SkipCommand}" CommandParameter="20" />
            <Button Style="{StaticResource JogButton}" Content="+1m"
                    ToolTip="Forward 1 minute"
                    Command="{Binding SkipCommand}" CommandParameter="60" />
            <Button Style="{StaticResource JogButton}" Content="+5m"
                    ToolTip="Forward 5 minutes"
                    Command="{Binding SkipCommand}" CommandParameter="300" />
            <Button Style="{StaticResource JogButton}" Content="+10m"
                    ToolTip="Forward 10 minutes"
                    Command="{Binding SkipCommand}" CommandParameter="600" />
            <Button Style="{StaticResource JogButton}" Content="+20m"
                    ToolTip="Forward 20 minutes"
                    Command="{Binding SkipCommand}" CommandParameter="1200" />

            <Button Style="{StaticResource JogButton}" Content="&#x2759;&#x25BA;"
                    ToolTip="Jump to end"
                    Command="{Binding JumpToEndCommand}" />
        </WrapPanel>

        <!-- Transport + time readout — sits on a rounded secondary-surface bar. -->
        <Border Grid.Row="3" Margin="0,6,0,0" Padding="8,6"
                Background="{StaticResource Surface2Brush}"
                CornerRadius="{StaticResource RadiusSm}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Play/pause now lives in the jog row above; Stop stays on the transport row. -->
            <Button Grid.Column="0"
                    Padding="10,3"
                    Content="Stop"
                    Command="{Binding StopCommand}" />

            <!-- Audio (mute + volume) and playback speed — compact, on the transport line. -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button MinWidth="52"
                        Padding="6,3"
                        Margin="8,0,4,0"
                        Content="{Binding MuteLabel}"
                        ToolTip="Toggle mute"
                        Command="{Binding MuteCommand}" />
                <Slider Width="90"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="1"
                        Value="{Binding Volume, Mode=TwoWay}"
                        ToolTip="Volume" />
                <ComboBox Margin="10,0,4,0"
                          MinWidth="64"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding SpeedPresets}"
                          SelectedItem="{Binding SpeedRatio, Mode=TwoWay}"
                          ToolTip="Playback speed">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0}x}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       Foreground="{StaticResource TextPrimaryBrush}">
                <Run Text="{Binding PositionText, Mode=OneWay}" />
                <Run Text=" / " Foreground="{StaticResource TextMutedBrush}" />
                <Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
            </TextBlock>
        </Grid>
        </Border>

        <!-- Preview-unavailable banner — warning role, kept noticeable via muted-gold fill + gold headline. -->
        <Border Grid.Row="4"
                Margin="0,6,0,0"
                Padding="8"
                Background="{StaticResource AccentMutedBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}"
                Visibility="{Binding PreviewFailed, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Preview unavailable — you can still cut this file."
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap" />
                <!-- Selectable + copyable reason (T-037) -->
                <TextBox Margin="0,2,0,0"
                         Text="{Binding PreviewFailedReason, Mode=OneWay}"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         TextWrapping="Wrap"
                         MaxHeight="120"
                         VerticalScrollBarVisibility="Auto" />
                <Button Content="Copy"
                        Margin="0,4,0,0"
                        Padding="8,2"
                        HorizontalAlignment="Left"
                        ToolTip="Copy the preview error to the clipboard"
                        Click="OnCopyPreviewErrorClicked" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
