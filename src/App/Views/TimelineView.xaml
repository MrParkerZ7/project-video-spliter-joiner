<UserControl x:Class="VideoSplitJoiner.App.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- The track: fixed-height strip; ticks + playhead are drawn onto Track in code-behind. -->
        <Border BorderBrush="#B0B0B0"
                BorderThickness="1"
                Background="#F3F3F3"
                Height="34"
                Cursor="Hand"
                ToolTip="Click to drop a cut here; click a marker tick to seek.">
            <Canvas x:Name="Track"
                    ClipToBounds="True"
                    Background="Transparent"
                    SizeChanged="OnTrackSizeChanged"
                    MouseLeftButtonUp="OnTrackClicked" />
        </Border>

        <!-- Legend -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Rectangle Width="12" Height="12" Fill="#3A6EA5" VerticalAlignment="Center" />
            <TextBlock Text="marker" Margin="4,0,10,0" VerticalAlignment="Center" FontSize="11" Foreground="#444" />
        </StackPanel>
    </StackPanel>
</UserControl>
