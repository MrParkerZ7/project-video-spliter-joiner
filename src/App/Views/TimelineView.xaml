<UserControl x:Class="VideoSplitJoiner.App.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VideoSplitJoiner.App.Views">
    <UserControl.Resources>
        <conv:CandidateKindToBrushConverter x:Key="KindToBrush" />
    </UserControl.Resources>

    <StackPanel>
        <!-- The track: fixed-height strip; ticks + playhead are drawn onto Track in code-behind. -->
        <Border BorderBrush="#B0B0B0"
                BorderThickness="1"
                Background="#F3F3F3"
                Height="34"
                Cursor="Hand"
                ToolTip="Click to drop a cut here; click a tick to seek / preview.">
            <Canvas x:Name="Track"
                    ClipToBounds="True"
                    Background="Transparent"
                    SizeChanged="OnTrackSizeChanged"
                    MouseLeftButtonUp="OnTrackClicked" />
        </Border>

        <!-- Legend -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Rectangle Width="12" Height="12" Fill="#3A6EA5" VerticalAlignment="Center" />
            <TextBlock Text="marker" Margin="4,0,10,0" VerticalAlignment="Center" FontSize="11" Foreground="#444" />
            <Rectangle Width="12" Height="12" VerticalAlignment="Center"
                       Fill="{Binding Source={x:Static conv:TimelineView.BlackKindBrush}}" />
            <TextBlock Text="black" Margin="4,0,10,0" VerticalAlignment="Center" FontSize="11" Foreground="#444" />
            <Rectangle Width="12" Height="12" VerticalAlignment="Center"
                       Fill="{Binding Source={x:Static conv:TimelineView.WhiteKindBrush}}" />
            <TextBlock Text="white" Margin="4,0,10,0" VerticalAlignment="Center" FontSize="11" Foreground="#444" />
            <Rectangle Width="12" Height="12" VerticalAlignment="Center"
                       Fill="{Binding Source={x:Static conv:TimelineView.SceneKindBrush}}" />
            <TextBlock Text="scene" Margin="4,0,10,0" VerticalAlignment="Center" FontSize="11" Foreground="#444" />
        </StackPanel>
    </StackPanel>
</UserControl>
