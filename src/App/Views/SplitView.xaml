<UserControl x:Class="VideoSplitJoiner.App.Views.SplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:views="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:vm="clr-namespace:VideoSplitJoiner.App.ViewModels">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:FractionToPercentConverter x:Key="FractionToPercent" />

        <!-- Small mono section-header label, e.g. "Cut markers" / "Parts to export" (T-059). -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Mono field label (DIR / NAME / Position) — faint, small, upper-ish (T-059). -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- All / None select chip — compact, muted surface (T-059). -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="MinWidth" Value="44" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Margin="8"
          AllowDrop="True"
          PreviewDragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop">
        <!-- ★ D-001 / T-081 axis-aware body: the SAME two regions — video/timeline block +
             tool panel — laid out side-by-side (horizontal) or stacked (vertical) from the
             MainViewModel's IsVertical. One instance of each region; the OrientedSplitPanel
             owns the themed splitter and the per-axis remembered ratios. IsVertical + the two
             ratios come from the Window's DataContext (MainViewModel); this UserControl's own
             DataContext stays the SplitViewModel. -->
        <views:OrientedSplitPanel
                IsVertical="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=Window}}"
                HorizontalRatio="{Binding DataContext.HorizontalSplitRatio, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                VerticalRatio="{Binding DataContext.VerticalSplitRatio, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
            <views:OrientedSplitPanel.FirstChild>

        <!-- ================= REGION 1: video preview + timeline (left / top) ================= -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: resizable video preview pane (T-027) -->
                <RowDefinition Height="*" MinHeight="140" />
                <!-- Row 1: drag handle to resize the preview vs the timeline below -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: timeline overlay — wave band (T-084, ~48px, shown only with audio) +
                     34px track + legend; MinHeight lifted so the fused unit is never clipped. -->
                <RowDefinition Height="Auto" MinHeight="130" />
            </Grid.RowDefinitions>

            <!-- In-app video preview (T-012), user-resizable (T-027) -->
            <views:PlayerView Grid.Row="0"
                              DataContext="{Binding Player}"
                              Visibility="{Binding DataContext.HasFile,
                                           RelativeSource={RelativeSource AncestorType=UserControl},
                                           Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty-state hint when no file is loaded (T-059) -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Visibility="{Binding HasFile, Converter={StaticResource BoolToCollapsed}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No file loaded"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource SansFontFamily}"
                               FontSize="{StaticResource FontSizeTitle}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Load a video or drop it here to begin."
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <!-- Drag handle: resize the preview against the timeline below (T-027) -->
            <GridSplitter Grid.Row="1"
                          Height="6"
                          Margin="0,6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          ToolTip="Drag to resize the video preview" />

            <!-- Timeline overlay: markers + candidates (T-014) -->
            <views:TimelineView Grid.Row="2"
                                DataContext="{Binding Timeline}"
                                Visibility="{Binding DataContext.HasFile,
                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                             Converter={StaticResource BoolToVisibility}}" />
        </Grid>

            </views:OrientedSplitPanel.FirstChild>

        <!-- ================= REGION 2: tool panel (Load → Run) — bounded 50/50 star Grid (right / bottom) =================
             D-003 / T-090: the container is a BOUNDED Grid (no outer ScrollViewer — that gave infinite height and
             defeated star-sizing). Fixed elements are Auto rows; the two lists (Cut markers · Parts to export) are
             two * rows that split the leftover height 50/50 and grow with the window; each list scrolls internally.
             The Grid fills the OrientedSplitPanel.SecondChild region, which is bounded in both layout modes. MinHeight
             keeps the panel (and its Run button) reachable in vertical mode on a short window. -->
            <views:OrientedSplitPanel.SecondChild>
        <Border MinHeight="120"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- 0: file-info card -->
                        <RowDefinition Height="Auto" />  <!-- 1: advisory notes (keyframe warning + drop summary, stacked) -->
                        <RowDefinition Height="*" MinHeight="180" />  <!-- 2: Cut markers ‖ Parts nested OrientedSplitPanel (T-091) -->
                        <RowDefinition Height="Auto" />  <!-- 3: Output section -->
                        <RowDefinition Height="Auto" />  <!-- 4: Run / progress / op-state surfaces -->
                    </Grid.RowDefinitions>

                    <!-- ===== File-info card =====
                         T-088 — the Load / Clear buttons moved OUT of this panel and onto the shared
                         Split/Join tab-strip line (MainWindow), reclaiming this top row. The file-info
                         card is now the first thing in the tool panel; drag-drop load still works on
                         the RootGrid, and the moved buttons drive this screen via CurrentLoad/Clear. -->
                    <!-- File-info card: name + mono meta line (container · duration · size) + badge (T-059) -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,0"
                            Padding="10"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Visibility="{Binding Info, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           FontFamily="{StaticResource SansFontFamily}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding InputPath}"
                                           VerticalAlignment="Center" />
                                <!-- Format/status badge: gold-accented mono chip -->
                                <Border Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="7,2"
                                        Background="{StaticResource AccentMutedBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="{Binding Badge}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding MetaLine}"
                                       Margin="0,4,0,0"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Row 1 holds this screen's advisory notes, stacked VERTICALLY (T-154). A vertical
                         StackPanel does not clip along its stacking axis, so the drop note joins the
                         keyframe warning here without renumbering the three Grid.Row attributes below —
                         and without the horizontal-StackPanel trap that silently clipped controls off
                         the right edge at 1280px three times (T-136, T-141, T-156). -->
                    <StackPanel Grid.Row="1">

                        <!-- Coarse-keyframe warning — warning role: muted-gold fill, gold border, primary text. -->
                        <Border Margin="0,10,0,0"
                                Padding="8"
                                Background="{StaticResource AccentMutedBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Visibility="{Binding KeyframeWarning, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding KeyframeWarning}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>

                        <!-- T-154 — what the drop did NOT load, and why. Collapsed when a drop refused
                             nothing, because a note on every drop is noise and noise is what teaches
                             people to ignore the one that matters. Split's own case, which Bulk Cut has
                             no phrase for: you dropped five videos, it opens one at a time. -->
                        <Border Margin="0,10,0,0"
                                Padding="8,4"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Visibility="{Binding DropSummary, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding DropSummary}"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- ===== Cut markers ‖ Parts to export — MODE-AWARE nested OrientedSplitPanel (T-091) =====
                         Row 2 is now the single * region of the tool-panel Grid; it hosts a NESTED
                         OrientedSplitPanel whose two regions are the Cut-markers block (FirstChild) and the
                         Parts-to-export block (SecondChild), each a self-contained Grid: an Auto header row
                         over a * list row (the ListBox stretches to fill and scrolls internally).

                         The nested panel's IsVertical is the INVERSE of the main axis (via InverseBool), so it
                         flips OPPOSITE to the outer video/tools split (corrects the D-003 miss where the pair
                         was permanently stacked):
                           Main.IsVertical=false (horizontal MODE, narrow panel) → inner IsVertical=true  → ROWS   → markers stacked ABOVE parts (50/50 height)
                           Main.IsVertical=true  (vertical MODE,   wide  panel) → inner IsVertical=false → COLUMNS → markers | parts SIDE BY SIDE (50/50 width)
                         HorizontalRatio/VerticalRatio pinned to 0.5 for a true 50/50 in both axes (session-only
                         DP values — bound to nothing, no AppSettings churn). The themed GridSplitter between the
                         two blocks is draggable in both modes.
                         Pure re-parent — every command/binding below is carried over verbatim from D-003. The
                         OUTER OrientedSplitPanel (D-001) and its IsVertical/HorizontalSplitRatio/VerticalSplitRatio
                         bindings are untouched. -->
                    <views:OrientedSplitPanel Grid.Row="2"
                            Margin="0,14,0,0"
                            IsVertical="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                            HorizontalRatio="0.5"
                            VerticalRatio="0.5">

                        <!-- FirstChild: Cut-markers block (header + Add-cut/Position wrap-row + marker list) -->
                        <views:OrientedSplitPanel.FirstChild>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />  <!-- header + Add-cut / Position wrapping row -->
                                    <RowDefinition Height="*" MinHeight="90" />  <!-- marker list — fills, scrolls internally -->
                                </Grid.RowDefinitions>

                                <!-- Cut-markers header + Add-cut / Position wrapping row (D1) -->
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Cut markers" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />

                                    <!-- D1 · both add gestures for the Cut-markers section:
                                         PRIMARY (T-064) "Add cut at playhead" — drops a cut at the LIVE playhead each click, so
                                         "position the video, click Add, repeat" just works;
                                         SECONDARY (T-064) the typed POSITION field + "Add at time" — precise entry; the field
                                         auto-follows the playhead (NewMarkerPosition seeding), edit to override.

                                         T-092 · the PRIMARY gesture now uses the extra-highlight HeroButton (gold + Bold +
                                         larger + ✚ icon + soft gold glow) and sits on ITS OWN LINE above the secondary row —
                                         it grew too prominent to share the WrapPanel gracefully, and it IS the main action.
                                         The secondary POSITION field + "Add at time" stay on the wrapping row below. -->
                                    <Button Style="{StaticResource HeroButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,8"
                                            ToolTip="Drop a cut at the preview player's current position (snaps to the nearest keyframe). Scrub, then click again to add the next cut."
                                            Command="{Binding SetCutAtPlayheadCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- ✚ add-cut glyph — 1px vector Path (crisp at 100%/150% DPI),
                                                 strokes with the button's accent text foreground. -->
                                            <Path Data="M6,0.5 L6,11.5 M0.5,6 L11.5,6"
                                                  Stroke="{DynamicResource AccentTextBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="12" Height="12"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  SnapsToDevicePixels="True"
                                                  UseLayoutRounding="True" />
                                            <TextBlock Text="Add cut at playhead"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Secondary add-by-time row: POSITION field + "Add at time".
                                         WrapPanel so the label + 86px field + button wrap when narrow, single-line when roomy. -->
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="POSITION" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <TextBox x:Name="PositionBox"
                                                 Width="86"
                                                 Margin="8,0,0,4"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding NewMarkerPosition, Mode=TwoWay}"
                                                 ToolTip="Time from start, e.g. 00:01:23.5 — follows the playhead; type to override" />
                                        <Button Content="Add at time"
                                                Margin="8,0,0,4"
                                                Padding="10,3"
                                                VerticalAlignment="Center"
                                                ToolTip="Add a cut marker at the exact position typed above"
                                                Command="{Binding AddMarkerCommand}" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Marker list — fills its region, scrolls internally. MinHeight keeps it usable (D6). -->
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Markers}"
                                         Margin="0,6,0,0"
                                         MinHeight="90">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CutMarkerViewModel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Display}"
                                                           FontFamily="{StaticResource MonoFontFamily}" />
                                                <Button Grid.Column="1"
                                                        Content="▶ seek"
                                                        Padding="6,1"
                                                        Margin="0,0,4,0"
                                                        ToolTip="Seek the preview player to this cut's snapped time"
                                                        Command="{Binding DataContext.SeekToMarkerCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="2"
                                                        Content="Remove"
                                                        Padding="6,1"
                                                        Command="{Binding DataContext.RemoveMarkerCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </views:OrientedSplitPanel.FirstChild>

                        <!-- SecondChild: Parts-to-export block (header + (N selected) + All/None + segments list) -->
                        <views:OrientedSplitPanel.SecondChild>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />  <!-- header: title + count + All/None chips -->
                                    <RowDefinition Height="*" MinHeight="90" />  <!-- segments list — fills, scrolls internally -->
                                </Grid.RowDefinitions>

                                <!-- Parts-to-export header (full width, D4): title + "(N selected)" + All/None chips -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Parts to export" Style="{StaticResource SectionHeader}" Margin="0" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding SelectedSegmentCount, StringFormat={}({0} selected)}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="All"
                                            Style="{StaticResource ChipButton}"
                                            Margin="0,0,4,0"
                                            ToolTip="Select every part for export"
                                            Command="{Binding SelectAllSegmentsCommand}" />
                                    <Button Grid.Column="2"
                                            Content="None"
                                            Style="{StaticResource ChipButton}"
                                            ToolTip="Deselect every part"
                                            Command="{Binding SelectNoSegmentsCommand}" />
                                </Grid>

                                <!-- Parts list (T-049 select) — fills its region, scrolls internally. MinHeight keeps it usable (D6). -->
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Segments}"
                                         MinHeight="90"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SplitSegmentViewModel}">
                                            <!-- T-069: row = selection checkbox (flexes) + inline per-part progress
                                                 affordance. The affordance shows the row's live write state:
                                                 Writing → a thin gold bar + % ; Done → a green ✓ ; Pending → nothing. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Content="{Binding Display}"
                                                          FontFamily="{StaticResource MonoFontFamily}"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Uncheck to exclude this part from the export" />

                                                <!-- WRITING: gold live-fill bar + % (active row) -->
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding IsWriting, Converter={StaticResource BoolToVisibility}}">
                                                    <ProgressBar Width="52"
                                                                 Height="6"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Foreground="{StaticResource AccentBrush}"
                                                                 Background="{StaticResource Surface2Brush}"
                                                                 BorderThickness="0"
                                                                 VerticalAlignment="Center"
                                                                 Value="{Binding PartFraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               MinWidth="30"
                                                               TextAlignment="Right"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               Text="{Binding PartFraction, Mode=OneWay, Converter={StaticResource FractionToPercent}, StringFormat={}{0:0}%}" />
                                                </StackPanel>

                                                <!-- DONE: green check -->
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,4,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource OkBrush}"
                                                           Text="✓ done"
                                                           Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </views:OrientedSplitPanel.SecondChild>
                    </views:OrientedSplitPanel>

                    <!-- Row 3 · Output section (mono DIR / NAME fields + overwrite toggle) — Auto -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Output" Style="{StaticResource SectionHeader}" Margin="0,14,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DIR" Style="{StaticResource FieldLabel}" Margin="0,0,8,4" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding OutputDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="NAME" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NamingPattern, Mode=TwoWay}" />
                        </Grid>

                        <CheckBox Content="Overwrite existing segments"
                                  Margin="0,10,0,0"
                                  IsChecked="{Binding Overwrite, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Row 4 · Run / progress / op-state surfaces (Auto) — the Run button always sits at the bottom of
                         the bounded Grid and stays reachable: the two lists absorb overflow via their internal scroll,
                         so this Auto row is never pushed off-panel. (Fallback outer ScrollViewer was NOT needed — the
                         plain bounded Grid + internal list scroll keeps Run reachable per D6.) -->
                    <StackPanel Grid.Row="4">

                    <!-- ===== T-163: reclaim the source automatically =====
                         A WrapPanel, never a horizontal StackPanel: a StackPanel neither wraps nor
                         scrolls, it silently CLIPS whatever does not fit off the right edge, and this
                         panel is narrow (it lives inside the tool pane). That failure has shipped four
                         times already — T-136 the profile bar, T-141 the header, T-156 and T-160 the
                         Bulk footer — so it is not repeated here on the way in.

                         Both default OFF; the second is disabled until the first is on, because
                         emptying the bin frees nothing this app put there otherwise, and arming it asks
                         once because the pair is permanent deletion with no undo. -->
                    <WrapPanel x:Name="SplitFooterOptions" Margin="0,10,0,0" VerticalAlignment="Center">
                        <CheckBox VerticalAlignment="Center"
                                  Content="Auto-delete source"
                                  IsChecked="{Binding AutoDeleteSource, Mode=TwoWay}"
                                  ToolTip="After a split finishes and every part is verified on disk, send the source file to the Recycle Bin automatically. A split that produced an incomplete set never deletes anything." />

                        <CheckBox Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding CanAutoEmptyRecycleBin}"
                                  IsChecked="{Binding AutoEmptyRecycleBin, Mode=TwoWay}"
                                  ToolTip="Also empty the Recycle Bin, so the space is actually freed. This makes the deletion PERMANENT and unrecoverable, and empties the whole bin — including files this app never touched.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" Margin="0,0,5,0" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Text="and empty bin"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DangerBrush}" />
                            </StackPanel>
                        </CheckBox>

                        <!-- The armed state, visible BEFORE Run is pressed rather than discovered after
                             a split has already removed something. -->
                        <TextBlock Text="{Binding DestructiveOutputNote}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Visibility="{Binding DestructiveOutputNote, Converter={StaticResource NullToCollapsed}}" />
                    </WrapPanel>

                    <!-- ===== Action row: destructive at one end, Run at the other (T-162) =====
                         A Grid, NOT a horizontal StackPanel. T-146 learned this on Bulk Cut the hard way:
                         appending the destructive button after Run in a StackPanel and setting
                         HorizontalAlignment="Left" does nothing, because alignment is inert along a
                         StackPanel's stacking axis — the button landed on the pixels Run had just
                         occupied, under the cursor of someone pressing Run repeatedly. Its own column
                         makes the separation structural instead of advisory. -->
                    <Grid x:Name="SplitActionRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />   <!-- 0: delete original, far left OF THIS ROW -->
                            <ColumnDefinition Width="*" />      <!-- 1: the gap that keeps them apart -->
                            <ColumnDefinition Width="Auto" />   <!-- 2: Run + Cancel -->
                        </Grid.ColumnDefinitions>

                        <!-- T-162: hidden until it can actually do something. A permanently-greyed
                             destructive button just trains people to ignore it, and this one is only
                             offered once every produced part is verified on disk. -->
                        <Button Grid.Column="0"
                                x:Name="DeleteOriginalButton"
                                Style="{StaticResource DangerButton}"
                                Content="{Binding DeleteOriginalLabel}"
                                Margin="0,0,28,0"
                                VerticalAlignment="Center"
                                Command="{Binding DeleteOriginalCommand}"
                                ToolTip="Send the source file to the Recycle Bin. Offered only once every part this split produced is on disk and non-empty — if any part is missing, the source is the only copy of that footage and nothing is deleted. Never a permanent delete."
                                Visibility="{Binding CanDeleteOriginal, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}"
                                    Content="{Binding RunLabel}"
                                    Padding="16,6"
                                    x:Name="RunSplitButton"
                                    Command="{Binding RunSplitCommand}" />
                            <Button Content="Cancel"
                                    Margin="6,0,0,0"
                                    Padding="10,5"
                                    Command="{Binding CancelCommand}"
                                    Visibility="{Binding Operation.CanCancel, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Height="16"
                                 Margin="0,10,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 IsIndeterminate="{Binding Operation.IsIndeterminate, Mode=OneWay}"
                                 Value="{Binding Operation.Progress, Mode=OneWay, Converter={StaticResource FractionToPercent}}"
                                 Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Running status line + ETA ("Splitting… (3 parts)   ~40s left") — visible while running (T-042/T-045) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0"
                                Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding Operation.StatusText}" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Operation.EtaText}"
                                   Visibility="{Binding Operation.EtaText, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!-- ===== COMPLETED surface (T-073): ✓ green + result summary + Open folder =====
                         Visible only on Operation.IsCompleted; persists until the next run/load/Clear
                         (which flips the state away from Completed). One of the four mutually-exclusive
                         lifecycle surfaces — Running / Completed / Cancelled / Failed. -->
                    <Border Margin="0,8,0,0"
                            Padding="8"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource OkBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Visibility="{Binding Operation.IsCompleted, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✓"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource OkBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding Operation.ResultSummary}" />
                            <Button Content="Open folder"
                                    Margin="10,0,0,0"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    ToolTip="Reveal the output folder in Explorer"
                                    Command="{Binding OpenFolderCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== CANCELLED surface (T-073): muted "Cancelled" — neutral, NOT error-red =====
                         Visible only on Operation.IsCancelled. -->
                    <Border Margin="0,8,0,0"
                            Padding="8"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Visibility="{Binding Operation.IsCancelled, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Cancelled"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Free-form VM status line (load result / "Split complete.") — shown when not running -->
                    <TextBlock Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding StatusText}"
                               Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Error headline + hint + copyable, selectable full-log details (T-037) — danger role on dark. -->
                    <Border Margin="0,6,0,0"
                            Padding="8"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Visibility="{Binding Operation.Error, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Operation.Error.Message}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Operation.Error.Hint}"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Visibility="{Binding Operation.Error.Hint, Converter={StaticResource NullToCollapsed}}" />

                            <!-- Action row: copy the full error, open the saved full log -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Copy error"
                                        Padding="8,2"
                                        ToolTip="Copy the full error (message + full log) to the clipboard"
                                        Click="OnCopyErrorClicked" />
                                <Button Content="Open log file"
                                        Margin="6,0,0,0"
                                        Padding="8,2"
                                        ToolTip="Reveal the saved full log in Explorer"
                                        Click="OnOpenLogClicked"
                                        Visibility="{Binding Operation.Error.HasLogFile, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Expander Header="Details (full log — selectable)" Margin="0,4,0,0" IsExpanded="True">
                                <TextBox Text="{Binding Operation.Error.DetailText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         IsReadOnlyCaretVisible="True"
                                         FontFamily="{StaticResource MonoFontFamily}"
                                         TextWrapping="Wrap"
                                         MaxHeight="180"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Results panel -->
                    <StackPanel Margin="0,6,0,0"
                                Visibility="{Binding LastResult, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Segments produced:" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="Open folder"
                                    Margin="8,0,0,0"
                                    Padding="6,1"
                                    Command="{Binding OpenFolderCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding LastResult.Segments}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="{StaticResource MonoFontFamily}">
                                        <Run Text="{Binding Path, Mode=OneWay}" />
                                        <Run Text=" @ " />
                                        <Run Text="{Binding ActualStart, Mode=OneWay}" />
                                        <Run Text=" (Δ " />
                                        <Run Text="{Binding Delta, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </StackPanel>
                </Grid>
        </Border>
            </views:OrientedSplitPanel.SecondChild>
        </views:OrientedSplitPanel>

        <!-- ================= Drag-drop highlight overlay (T-016) =================
             Overlays the whole body (RootGrid has a single implicit cell now that the
             axis-aware split lives inside OrientedSplitPanel). -->
        <Border x:Name="DropHighlight"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="3"
                Background="{StaticResource AccentMutedBrush}"
                CornerRadius="{StaticResource RadiusSm}" />
    </Grid>
</UserControl>
