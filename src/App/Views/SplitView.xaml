<UserControl x:Class="VideoSplitJoiner.App.Views.SplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:views="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:vm="clr-namespace:VideoSplitJoiner.App.ViewModels">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:FractionToPercentConverter x:Key="FractionToPercent" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Margin="8"
          AllowDrop="True"
          PreviewDragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop">
        <Grid.RowDefinitions>
            <!-- Row 0: resizable video preview pane (T-027) -->
            <RowDefinition Height="300" MinHeight="140" />
            <!-- Row 1: drag handle to resize the preview vs the content below -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: timeline + markers + output/run — star-sized, never clipped -->
            <RowDefinition Height="*" MinHeight="200" />
        </Grid.RowDefinitions>

        <!-- ================= TOP: in-app video preview (T-012), user-resizable (T-027) ================= -->
        <views:PlayerView Grid.Row="0"
                          Margin="0,0,0,6"
                          DataContext="{Binding Player}"
                          Visibility="{Binding DataContext.HasFile,
                                       RelativeSource={RelativeSource AncestorType=UserControl},
                                       Converter={StaticResource BoolToVisibility}}" />

        <!-- ============ Drag handle: resize the preview against the content below (T-027) ============ -->
        <GridSplitter Grid.Row="1"
                      Height="6"
                      Margin="0,0,0,6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      Background="#D0D0D0"
                      ToolTip="Drag to resize the video preview" />

        <!-- ================= Content: timeline + markers + output/run ================= -->
        <Grid Grid.Row="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Timeline overlay: markers + candidates (T-014) ============ -->
        <views:TimelineView Grid.Row="0"
                            Margin="0,0,0,10"
                            DataContext="{Binding Timeline}"
                            Visibility="{Binding DataContext.HasFile,
                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                         Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: file + markers ================= -->
        <DockPanel Grid.Column="0">

            <!-- File load + info -->
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="LoadButton"
                            Content="Load…"
                            Padding="12,4"
                            Click="OnLoadClicked" />
                    <Button x:Name="ClearButton"
                            Content="Clear"
                            Margin="6,0,0,0"
                            Padding="12,4"
                            ToolTip="Unload the current file and reset the Split screen"
                            Command="{Binding ClearCommand}" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding InputPath}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Margin="0,6,0,0"
                           Visibility="{Binding Info, Converter={StaticResource NullToCollapsed}}">
                    <Run Text="Duration: " FontWeight="Bold" />
                    <Run Text="{Binding Info.Duration, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Visibility="{Binding Info, Converter={StaticResource NullToCollapsed}}">
                    <Run Text="Container: " FontWeight="Bold" />
                    <Run Text="{Binding Info.Container, Mode=OneWay}" />
                </TextBlock>

                <!-- Coarse-keyframe warning -->
                <Border Margin="0,6,0,0"
                        Padding="6"
                        Background="#FFF7E6"
                        BorderBrush="#E8B84B"
                        BorderThickness="1"
                        Visibility="{Binding KeyframeWarning, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding KeyframeWarning}" TextWrapping="Wrap" Foreground="#7A5C00" />
                </Border>

                <!-- Add-marker input -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                    <TextBlock Text="Position:" VerticalAlignment="Center" />
                    <TextBox x:Name="PositionBox"
                             Width="90"
                             Margin="6,0,0,0"
                             Text="{Binding NewMarkerPosition, Mode=TwoWay}"
                             ToolTip="Time from start, e.g. 00:01:23.5" />
                    <Button Content="Add marker"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            Command="{Binding AddMarkerCommand}" />
                    <Button Content="Set cut point at playhead"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            ToolTip="Drop a cut at the preview player's current position (snaps to the nearest keyframe)"
                            Command="{Binding SetCutAtPlayheadCommand}" />
                </StackPanel>
                <TextBlock Text="Cut markers (snapped to keyframe):" FontWeight="Bold" Margin="0,4,0,2" />
            </StackPanel>

            <!-- ====== Selectable split parts (T-049): checkbox per part + select all/none ====== -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Parts to export:" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#555"
                               Text="{Binding SelectedSegmentCount, StringFormat={}({0} selected)}" />
                    <Button Content="All"
                            Margin="10,0,0,0"
                            Padding="8,1"
                            ToolTip="Select every part for export"
                            Command="{Binding SelectAllSegmentsCommand}" />
                    <Button Content="None"
                            Margin="4,0,0,0"
                            Padding="8,1"
                            ToolTip="Deselect every part"
                            Command="{Binding SelectNoSegmentsCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Segments}" MaxHeight="140">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SplitSegmentViewModel}">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding Display}"
                                      FontFamily="Consolas"
                                      ToolTip="Uncheck to exclude this part from the export" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Marker list -->
            <ListBox ItemsSource="{Binding Markers}" MinHeight="120">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CutMarkerViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Display}"
                                       FontFamily="Consolas" />
                            <Button Grid.Column="1"
                                    Content="▶ seek"
                                    Padding="6,1"
                                    Margin="0,0,4,0"
                                    ToolTip="Seek the preview player to this cut's snapped time"
                                    Command="{Binding DataContext.SeekToMarkerCommand,
                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="2"
                                    Content="Remove"
                                    Padding="6,1"
                                    Command="{Binding DataContext.RemoveMarkerCommand,
                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ================= RIGHT: output + run ================= -->
        <DockPanel Grid.Column="2">

            <!-- Output + run controls anchored at the bottom -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Output dir:" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding OutputDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pattern:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NamingPattern, Mode=TwoWay}" />
                </Grid>

                <CheckBox Content="Overwrite existing segments"
                          Margin="0,6,0,0"
                          IsChecked="{Binding Overwrite, Mode=TwoWay}" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{Binding RunLabel}"
                            Padding="14,4"
                            FontWeight="Bold"
                            Command="{Binding RunSplitCommand}" />
                    <Button Content="Cancel"
                            Margin="6,0,0,0"
                            Padding="10,4"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding Operation.CanCancel, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <ProgressBar Height="16"
                             Margin="0,8,0,0"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="{Binding Operation.IsIndeterminate, Mode=OneWay}"
                             Value="{Binding Operation.Progress, Mode=OneWay, Converter={StaticResource FractionToPercent}}"
                             Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}" />

                <!-- Running status line + ETA ("Splitting… (3 parts)   ~40s left") — visible while running (T-042/T-045) -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,6,0,0"
                            Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="#333"
                               Text="{Binding Operation.StatusText}" />
                    <!-- ETA — small, muted, shown next to the status (T-045) -->
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#777"
                               Text="{Binding Operation.EtaText}"
                               Visibility="{Binding Operation.EtaText, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <!-- Free-form VM status line (load result / "Split complete.") — shown when not running -->
                <TextBlock Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="#333"
                           Text="{Binding StatusText}"
                           Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />

                <!-- Error headline + hint + copyable, selectable full-log details (T-037) -->
                <Border Margin="0,6,0,0"
                        Padding="6"
                        Background="#FDECEA"
                        BorderBrush="#E57373"
                        BorderThickness="1"
                        Visibility="{Binding Operation.Error, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Operation.Error.Message}" FontWeight="Bold" Foreground="#B71C1C" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Operation.Error.Hint}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#7A2018"
                                   Visibility="{Binding Operation.Error.Hint, Converter={StaticResource NullToCollapsed}}" />

                        <!-- Action row: copy the full error, open the saved full log -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Copy error"
                                    Padding="8,2"
                                    ToolTip="Copy the full error (message + full log) to the clipboard"
                                    Click="OnCopyErrorClicked" />
                            <Button Content="Open log file"
                                    Margin="6,0,0,0"
                                    Padding="8,2"
                                    ToolTip="Reveal the saved full log in Explorer"
                                    Click="OnOpenLogClicked"
                                    Visibility="{Binding Operation.Error.HasLogFile, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <Expander Header="Details (full log — selectable)" Margin="0,4,0,0" IsExpanded="True">
                            <TextBox Text="{Binding Operation.Error.DetailText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     IsReadOnlyCaretVisible="True"
                                     FontFamily="Consolas"
                                     TextWrapping="Wrap"
                                     MaxHeight="180"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Results panel -->
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding LastResult, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Segments produced:" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Content="Open folder"
                                Margin="8,0,0,0"
                                Padding="6,1"
                                Command="{Binding OpenFolderCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding LastResult.Segments}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas">
                                    <Run Text="{Binding Path, Mode=OneWay}" />
                                    <Run Text=" @ " />
                                    <Run Text="{Binding ActualStart, Mode=OneWay}" />
                                    <Run Text=" (Δ " />
                                    <Run Text="{Binding Delta, Mode=OneWay}" />
                                    <Run Text=")" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </DockPanel>
        </Grid>
        </Grid>

        <!-- ================= Drag-drop highlight overlay (T-016) ================= -->
        <Border x:Name="DropHighlight"
                Grid.Row="0"
                Grid.RowSpan="3"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                BorderBrush="#3399FF"
                BorderThickness="3"
                Background="#223399FF"
                CornerRadius="4" />
    </Grid>
</UserControl>
