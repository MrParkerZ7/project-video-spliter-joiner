<UserControl x:Class="VideoSplitJoiner.App.Views.JoinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:vm="clr-namespace:VideoSplitJoiner.App.ViewModels">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:FractionToPercentConverter x:Key="FractionToPercent" />
        <conv:BoolToCompatBrushConverter x:Key="BoolToCompatBrush" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          PreviewDragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop">
    <DockPanel Margin="8">

        <!-- ================= TOP: add files + compat banner ================= -->
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddFilesButton"
                        Content="Add files…"
                        Padding="12,4"
                        Click="OnAddFilesClicked" />
                <Button x:Name="ClearAllButton"
                        Content="Clear all"
                        Margin="6,0,0,0"
                        Padding="12,4"
                        ToolTip="Remove all queued clips and reset the Join screen"
                        Command="{Binding ClearCommand}" />
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#666"
                           Text="Add two or more compatible clips, order them, then join." />
            </StackPanel>

            <!-- Compat banner (green when compatible, red otherwise) -->
            <Border Margin="0,8,0,0"
                    Padding="8"
                    BorderThickness="1"
                    Background="{Binding IsCompatible, Converter={StaticResource BoolToCompatBrush}, ConverterParameter=bg}"
                    BorderBrush="{Binding IsCompatible, Converter={StaticResource BoolToCompatBrush}, ConverterParameter=border}">
                <TextBlock Text="{Binding CompatSummary}"
                           TextWrapping="Wrap"
                           FontWeight="Bold"
                           Foreground="{Binding IsCompatible, Converter={StaticResource BoolToCompatBrush}, ConverterParameter=fg}" />
            </Border>
        </StackPanel>

        <!-- ================= BOTTOM: output + run + status/result ================= -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Output file:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <CheckBox Content="Overwrite existing output"
                      Margin="0,6,0,0"
                      IsChecked="{Binding Overwrite, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Run join"
                        Padding="14,4"
                        FontWeight="Bold"
                        Command="{Binding RunJoinCommand}" />
                <Button Content="Cancel"
                        Margin="6,0,0,0"
                        Padding="10,4"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding Operation.CanCancel, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <ProgressBar Height="16"
                         Margin="0,8,0,0"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="{Binding Operation.IsIndeterminate, Mode=OneWay}"
                         Value="{Binding Operation.Progress, Mode=OneWay, Converter={StaticResource FractionToPercent}}"
                         Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}" />

            <!-- Running status line + ETA ("Joining… (2 clips)   ~40s left") — visible while running (T-042/T-045) -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,6,0,0"
                        Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap"
                           Foreground="#333"
                           Text="{Binding Operation.StatusText}" />
                <!-- ETA — small, muted, shown next to the status (T-045) -->
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="#777"
                           Text="{Binding Operation.EtaText}"
                           Visibility="{Binding Operation.EtaText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>

            <!-- Error headline + hint + copyable, selectable full-log details (T-037) -->
            <Border Margin="0,6,0,0"
                    Padding="6"
                    Background="#FDECEA"
                    BorderBrush="#E57373"
                    BorderThickness="1"
                    Visibility="{Binding Operation.Error, Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="{Binding Operation.Error.Message}" FontWeight="Bold" Foreground="#B71C1C" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Operation.Error.Hint}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Foreground="#7A2018"
                               Visibility="{Binding Operation.Error.Hint, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Action row: copy the full error, open the saved full log -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Copy error"
                                Padding="8,2"
                                ToolTip="Copy the full error (message + full log) to the clipboard"
                                Click="OnCopyErrorClicked" />
                        <Button Content="Open log file"
                                Margin="6,0,0,0"
                                Padding="8,2"
                                ToolTip="Reveal the saved full log in Explorer"
                                Click="OnOpenLogClicked"
                                Visibility="{Binding Operation.Error.HasLogFile, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Expander Header="Details (full log — selectable)" Margin="0,4,0,0" IsExpanded="True">
                        <TextBox Text="{Binding Operation.Error.DetailText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 IsReadOnlyCaretVisible="True"
                                 FontFamily="Consolas"
                                 TextWrapping="Wrap"
                                 MaxHeight="180"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Result line -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,6,0,0"
                        Visibility="{Binding LastResult, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="Joined →" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding LastResult.OutputPath}" />
                <Button Content="Open folder"
                        Margin="8,0,0,0"
                        Padding="6,1"
                        Command="{Binding OpenFolderCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- ================= MIDDLE: ordered clip list ================= -->
        <ListBox x:Name="ClipList"
                 ItemsSource="{Binding Items}"
                 MinHeight="140"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="OnClipListPreviewMouseLeftButtonDown"
                 PreviewMouseMove="OnClipListPreviewMouseMove"
                 Drop="OnClipListDrop">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:JoinItemViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InfoText}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="#666"
                                       Visibility="{Binding InfoText, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="▲"
                                    Padding="6,1"
                                    ToolTip="Move up"
                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="▼"
                                    Margin="4,0,0,0"
                                    Padding="6,1"
                                    ToolTip="Move down"
                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Remove"
                                    Margin="6,0,0,0"
                                    Padding="6,1"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

        <!-- ================= Drag-drop highlight overlay (T-016) ================= -->
        <Border x:Name="DropHighlight"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Margin="8"
                BorderBrush="#3399FF"
                BorderThickness="3"
                Background="#223399FF"
                CornerRadius="4" />
    </Grid>
</UserControl>
