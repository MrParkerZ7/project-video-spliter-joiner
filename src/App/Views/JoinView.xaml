<UserControl x:Class="VideoSplitJoiner.App.Views.JoinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:views="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:vm="clr-namespace:VideoSplitJoiner.App.ViewModels">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
        <conv:FractionToPercentConverter x:Key="FractionToPercent" />
        <conv:BoolToCompatBrushConverter x:Key="BoolToCompatBrush" />

        <!-- Small mono section-header label (T-059). -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Mono field label (FILE) — faint, small (T-059). -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Margin="8"
          AllowDrop="True"
          PreviewDragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop">
        <!-- ★ D-001 / T-081 axis-aware body: the SAME two regions — ordered clip list +
             tool panel — laid out side-by-side (horizontal) or stacked (vertical) from the
             MainViewModel's IsVertical. One instance of each region; OrientedSplitPanel owns the
             themed splitter and the per-axis remembered ratios. IsVertical + ratios come from the
             Window's DataContext (MainViewModel); this UserControl's DataContext stays the JoinViewModel. -->
        <views:OrientedSplitPanel
                IsVertical="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=Window}}"
                HorizontalRatio="{Binding DataContext.HorizontalSplitRatio, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                VerticalRatio="{Binding DataContext.VerticalSplitRatio, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
            <views:OrientedSplitPanel.FirstChild>

        <!-- ================= REGION 1: ordered clip list (left / top) ================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Clips" Style="{StaticResource SectionHeader}" />

            <ListBox x:Name="ClipList"
                     Grid.Row="1"
                     ItemsSource="{Binding Items}"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="OnClipListPreviewMouseLeftButtonDown"
                     PreviewMouseMove="OnClipListPreviewMouseMove"
                     Drop="OnClipListDrop">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:JoinItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InfoText}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding InfoText, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="▲"
                                        Padding="6,1"
                                        ToolTip="Move up"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="▼"
                                        Margin="4,0,0,0"
                                        Padding="6,1"
                                        ToolTip="Move down"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Remove"
                                        Margin="6,0,0,0"
                                        Padding="6,1"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty-state hint when no clips are queued (T-059) -->
            <Border Grid.Row="1"
                    IsHitTestVisible="False"
                    Background="Transparent"
                    Visibility="{Binding HasClips, Converter={StaticResource BoolToCollapsed}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No clips queued"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource SansFontFamily}"
                               FontSize="{StaticResource FontSizeTitle}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Add two or more compatible clips, or drop them here."
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>
        </Grid>

            </views:OrientedSplitPanel.FirstChild>

        <!-- ================= REGION 2: tool panel, scrollable (right / bottom) =================
             The splitter between regions is provided by OrientedSplitPanel. MinHeight keeps the panel
             (and its Run button) reachable in vertical mode on a short window — the ScrollViewer scrolls. -->
            <views:OrientedSplitPanel.SecondChild>
        <Border MinHeight="120"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12">
                <StackPanel>

                    <!-- T-154 — what the drop did NOT add, and why. Collapsed when a drop refused
                         nothing, because a note on every drop is noise and noise is what teaches people
                         to ignore the one that matters.

                         FIRST child on purpose: this whole tool panel lives inside the ScrollViewer
                         above, so a note appended at the end can be scrolled out of view and never seen.
                         The panel is vertical, which cannot clip along its stacking axis — the
                         horizontal-StackPanel trap of T-136 / T-141 / T-156. -->
                    <Border Margin="0,0,0,10"
                            Padding="8,4"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Visibility="{Binding DropSummary, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding DropSummary}"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>

                    <!-- ===== Compat banner =====
                         T-088 — the Add files… / Clear all buttons moved OUT of this panel and onto the
                         shared Split/Join tab-strip line (MainWindow), reclaiming this top row. The compat
                         banner is now the first thing in the tool panel; drag-drop add still works on the
                         RootGrid, and the moved buttons drive this screen via CurrentLoad/Clear. -->
                    <!-- Compat banner (green when compatible, red otherwise) — dark-tuned via the converter. -->
                    <Border Margin="0,0,0,0"
                            Padding="8"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="{Binding IsCompatible, Converter={StaticResource BoolToCompatBrush}, ConverterParameter=bg}"
                            BorderBrush="{Binding IsCompatible, Converter={StaticResource BoolToCompatBrush}, ConverterParameter=border}">
                        <TextBlock Text="{Binding CompatSummary}"
                                   TextWrapping="Wrap"
                                   FontWeight="Bold"
                                   Foreground="{Binding IsCompatible, Converter={StaticResource BoolToCompatBrush}, ConverterParameter=fg}" />
                    </Border>

                    <!-- ===== Estimated result panel (T-059) ===== -->
                    <TextBlock Text="Estimated result" Style="{StaticResource SectionHeader}" Margin="0,14,0,4" />
                    <Border Padding="10"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Total duration" Style="{StaticResource FieldLabel}" Margin="0,0,10,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                       HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding EstimatedDuration}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Approx. size" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding EstimatedSize}" />
                        </Grid>
                    </Border>

                    <!-- ===== Output section (mono FILE field) ===== -->
                    <TextBlock Text="Output" Style="{StaticResource SectionHeader}" Margin="0,14,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="FILE" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <CheckBox Content="Overwrite existing output"
                              Margin="0,10,0,0"
                              IsChecked="{Binding Overwrite, Mode=TwoWay}" />

                    <!-- ===== Primary Run (gold, count-aware) + Cancel ===== -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButton}"
                                Content="{Binding RunLabel}"
                                Padding="16,6"
                                Command="{Binding RunJoinCommand}" />
                        <Button Content="Cancel"
                                Margin="6,0,0,0"
                                Padding="10,5"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding Operation.CanCancel, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <ProgressBar Height="16"
                                 Margin="0,10,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 IsIndeterminate="{Binding Operation.IsIndeterminate, Mode=OneWay}"
                                 Value="{Binding Operation.Progress, Mode=OneWay, Converter={StaticResource FractionToPercent}}"
                                 Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Running status line + ETA ("Joining… (2 clips)   ~40s left") — visible while running (T-042/T-045) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0"
                                Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding Operation.StatusText}" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Operation.EtaText}"
                                   Visibility="{Binding Operation.EtaText, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!-- ===== COMPLETED surface (T-073): ✓ green + result summary + Open folder =====
                         Visible only on Operation.IsCompleted; persists until the next run/load/Clear
                         (which flips the state away from Completed). One of the four mutually-exclusive
                         lifecycle surfaces — Running / Completed / Cancelled / Failed. -->
                    <Border Margin="0,8,0,0"
                            Padding="8"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource OkBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Visibility="{Binding Operation.IsCompleted, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✓"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource OkBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding Operation.ResultSummary}" />
                            <Button Content="Open folder"
                                    Margin="10,0,0,0"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    ToolTip="Reveal the output folder in Explorer"
                                    Command="{Binding OpenFolderCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== CANCELLED surface (T-073): muted "Cancelled" — neutral, NOT error-red =====
                         Visible only on Operation.IsCancelled. -->
                    <Border Margin="0,8,0,0"
                            Padding="8"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Visibility="{Binding Operation.IsCancelled, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Cancelled"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Error headline + hint + copyable, selectable full-log details (T-037) — danger role on dark. -->
                    <Border Margin="0,6,0,0"
                            Padding="8"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Visibility="{Binding Operation.Error, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Operation.Error.Message}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Operation.Error.Hint}"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Visibility="{Binding Operation.Error.Hint, Converter={StaticResource NullToCollapsed}}" />

                            <!-- Action row: copy the full error, open the saved full log -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Copy error"
                                        Padding="8,2"
                                        ToolTip="Copy the full error (message + full log) to the clipboard"
                                        Click="OnCopyErrorClicked" />
                                <Button Content="Open log file"
                                        Margin="6,0,0,0"
                                        Padding="8,2"
                                        ToolTip="Reveal the saved full log in Explorer"
                                        Click="OnOpenLogClicked"
                                        Visibility="{Binding Operation.Error.HasLogFile, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Expander Header="Details (full log — selectable)" Margin="0,4,0,0" IsExpanded="True">
                                <TextBox Text="{Binding Operation.Error.DetailText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         IsReadOnlyCaretVisible="True"
                                         FontFamily="{StaticResource MonoFontFamily}"
                                         TextWrapping="Wrap"
                                         MaxHeight="180"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Result line -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0"
                                Visibility="{Binding LastResult, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="Joined →" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding LastResult.OutputPath}" />
                        <Button Content="Open folder"
                                Margin="8,0,0,0"
                                Padding="6,1"
                                Command="{Binding OpenFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
            </views:OrientedSplitPanel.SecondChild>
        </views:OrientedSplitPanel>

        <!-- ================= Drag-drop highlight overlay (T-016) =================
             Overlays the whole body (RootGrid has a single implicit cell now that the
             axis-aware split lives inside OrientedSplitPanel). -->
        <Border x:Name="DropHighlight"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="3"
                Background="{StaticResource AccentMutedBrush}"
                CornerRadius="{StaticResource RadiusSm}" />
    </Grid>
</UserControl>
