<Window x:Class="VideoSplitJoiner.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Split / Join"
        Height="600"
        Width="900"
        MinHeight="400"
        MinWidth="600">
    <Grid>
        <TabControl Margin="8">
            <TabItem Header="Split">
                <Grid>
                    <TextBlock Text="Split (coming soon)"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="Gray" />
                </Grid>
            </TabItem>
            <TabItem Header="Join">
                <Grid>
                    <TextBlock Text="Join (coming soon)"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="Gray" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
