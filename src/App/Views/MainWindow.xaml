<Window x:Class="VideoSplitJoiner.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VideoSplitJoiner.App.Views"
        Title="Video Split / Join"
        Height="600"
        Width="900"
        MinHeight="400"
        MinWidth="600">
    <Grid>
        <TabControl Margin="8">
            <TabItem Header="Split">
                <views:SplitView DataContext="{Binding Split}" />
            </TabItem>
            <TabItem Header="Join">
                <views:JoinView DataContext="{Binding Join}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
