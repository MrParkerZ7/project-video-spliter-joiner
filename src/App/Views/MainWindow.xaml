<Window x:Class="VideoSplitJoiner.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VideoSplitJoiner.App.Views"
        Title="{Binding WindowTitle}"
        Height="800"
        Width="1280"
        MinHeight="600"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <!-- T-068 — Windows taskbar-button progress. ProgressState/Value follow the CURRENTLY-ACTIVE
         screen's operation (CurrentOperation, driven by the selected tab): green fill while running
         with a real fraction, indeterminate pulse while "Preparing", red on failure, and cleared to
         None (no stuck bar) when idle/completed/cancelled. The ETA + % surface via Window.Title
         (WindowTitle) since the button itself can't render text. -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding CurrentOperation.TaskbarProgressState}"
                         ProgressValue="{Binding CurrentOperation.Progress}" />
    </Window.TaskbarItemInfo>

    <!-- T-056 — custom themed dark+gold caption via WindowChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <views:WindowStateToContentMarginConverter x:Key="ContentMargin" />
        <views:WindowStateToBorderThicknessConverter x:Key="BorderThickness" />
    </Window.Resources>

    <!-- T-066 — themed 1px frame line (collapses to 0 when maximized to avoid a stray line). -->
    <Border BorderThickness="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window},
                                      Converter={StaticResource BorderThickness}}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            Background="{DynamicResource BgBrush}">

    <!-- Root: caption row (34) on top, existing content below. Margin only
         insets in the Maximized state (invisible resize border). -->
    <Grid Margin="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window},
                           Converter={StaticResource ContentMargin}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Caption row ===================== -->
        <Grid Grid.Row="0"
              Background="{DynamicResource BgBrush}"
              MouseLeftButtonDown="Caption_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: gold accent mark + app title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="12,0,0,0">
                <Rectangle Width="3" Height="15" RadiusX="1.5" RadiusY="1.5"
                           Fill="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" />
                <!-- Caption stays on the plain app name (CaptionTitle); the running % + ETA overlay
                     lives on Window.Title (WindowTitle) for the taskbar, not here. -->
                <TextBlock Text="{Binding CaptionTitle}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>

            <!-- Middle column (Column 1) is empty draggable caption. -->

            <!-- Right: layout toggle · min / max-restore / close caption buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Top">
                <!-- T-081 / D-001 — layout-axis toggle. A layout control (distinct from the
                     window min/max/close cluster), so a small gap separates it. The icon shows
                     the mode the click switches TO (D5): a TALL rect while horizontal ("switch to
                     vertical"), a WIDE rect while vertical ("switch to horizontal"); the tooltip
                     tracks via LayoutToggleTooltip. Bound to ToggleLayoutCommand on the MainViewModel;
                     WindowChrome.IsHitTestVisibleInChrome comes from the CaptionButton style. -->
                <Button x:Name="LayoutToggleButton"
                        Style="{StaticResource CaptionButton}"
                        Margin="0,0,10,0"
                        ToolTip="{Binding LayoutToggleTooltip}"
                        Command="{Binding ToggleLayoutCommand}">
                    <Grid>
                        <!-- Horizontal mode → show the TALL (target = vertical) rectangle. -->
                        <Path x:Name="LayoutVerticalIcon"
                              Data="{StaticResource LayoutVerticalCaptionGeometry}"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVertical}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <!-- Vertical mode → show the WIDE (target = horizontal) rectangle. -->
                        <Path x:Name="LayoutHorizontalIcon"
                              Data="{StaticResource LayoutHorizontalCaptionGeometry}"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVertical}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>
                <!-- T-076 — crisp vector caption icons (min / max↔restore / close). -->
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource CaptionButton}"
                        ToolTip="Minimize"
                        Click="Minimize_Click">
                    <Path Data="{StaticResource MinimizeCaptionGeometry}"
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="1"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True" />
                </Button>
                <Button x:Name="MaxRestoreButton"
                        Style="{StaticResource CaptionButton}"
                        ToolTip="Maximize"
                        Click="MaxRestore_Click">
                    <!-- Both icons present; per-Path WindowState DataTriggers swap
                         Visibility (maximize square in Normal, restore double-square
                         in Maximized). No click-handler role in the swap. -->
                    <Grid>
                        <Path x:Name="MaximizeIcon"
                              Data="{StaticResource MaximizeCaptionGeometry}"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path x:Name="RestoreIcon"
                              Data="{StaticResource RestoreCaptionGeometry}"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseCaptionButton}"
                        ToolTip="Close"
                        Click="Close_Click">
                    <!-- Stroke tracks the button Foreground so the close-hover trigger
                         (Foreground → near-white) lightens the X on the red field. -->
                    <Path Data="{StaticResource CloseCaptionGeometry}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- App header (T-059): name + muted tagline "lossless · no re-encode" -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,10,16,4">
                <TextBlock Text="VideoSplitJoiner"
                           FontFamily="{DynamicResource SansFontFamily}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="lossless · no re-encode"
                           Margin="10,0,0,0"
                           FontFamily="{DynamicResource MonoFontFamily}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TabControl Grid.Row="1" Margin="8,4,8,8"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Split">
                    <views:SplitView DataContext="{Binding Split}" />
                </TabItem>
                <TabItem Header="Join">
                    <views:JoinView DataContext="{Binding Join}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
    </Border>
</Window>
