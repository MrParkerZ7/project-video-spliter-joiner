<UserControl x:Class="VideoSplitJoiner.App.Views.BulkCutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:views="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:vm="clr-namespace:VideoSplitJoiner.App.ViewModels"
             xmlns:bulk="clr-namespace:VideoSplitJoiner.Core.Bulk;assembly=VideoSplitJoiner.Core"
             xmlns:profiles="clr-namespace:VideoSplitJoiner.Core.Profiles;assembly=VideoSplitJoiner.Core">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
        <conv:FractionToPercentConverter x:Key="FractionToPercent" />
        <conv:ClockConverter x:Key="Clock" />
        <conv:FileNameConverter x:Key="FileName" />
        <conv:EmptyCountToVisibleConverter x:Key="EmptyCountToVisible" />
        <conv:PositiveCountToVisibleConverter x:Key="PositiveCountToVisible" />
        <conv:RowStateConverter x:Key="RowState" />
        <!-- T-107: null-safe path→ImageSource (loads with BitmapCacheOption.OnLoad so the file isn't
             held open, returns null on a null/blank/missing path → the placeholder chip shows through).
             Reused verbatim from the T-078 scrub-thumb converter — same OnLoad + null-safety contract. -->
        <conv:PathToBitmapConverter x:Key="PathToBitmap" />

        <!-- Profile row: [thumb chip] Name — the ComboBox ItemTemplate (drives BOTH the drop-down rows
             and the selection box). The muted chip is the placeholder; the Image covers it when a
             thumbnail path resolves, and stays transparent (chip shows) when it is null/missing. -->
        <!-- T-161: one profile chip in the scrollable bar. Selected state is marked by THREE
             differentiators, never a tint alone — accent border (colour-role), muted-accent fill
             (colour-role), and a visible accent bar under the label (ornament).

             The bar is reserved with Visibility="Hidden" rather than Collapsed at rest, so selecting a
             chip changes no measurement and the row cannot twitch as the selection moves; likewise the
             border thickness is constant and only its brush changes. -->
        <Style x:Key="ProfileChipItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                SnapsToDevicePixels="True">
                            <StackPanel Margin="{TemplateBinding Padding}">
                                <ContentPresenter />
                                <Rectangle x:Name="SelectedBar"
                                           Height="3"
                                           Margin="0,3,0,0"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Visibility="Hidden"
                                           Fill="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentMutedBrush}" />
                                <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProfileItemTemplate" DataType="{x:Type profiles:CutProfile}">
            <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True">
                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToBitmap}}"
                           Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="{Binding Name}"
                           Margin="8,0,2,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- Small mono field label. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- T-119: compact secondary readout showing where a cut actually SNAPPED to.
             De-emphasised vs the editable request (muted colour-role + smaller size = two
             differentiators, never a tint alone) so it reads as an annotation, not a second input. -->
        <Style x:Key="SnapNote" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Small mono editable time field for the IN/OUT readouts. -->
        <Style x:Key="TimeField" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Width" Value="82" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ===== T-113: cut-profiles cluster styles (visual-only regroup) =====
             Two view-local button treatments that give the profiles card a clear
             action hierarchy (Save = accent primary uses the shared AccentButton;
             these two are the SECONDARY + MUTED tiers). Tokens only. -->

        <!-- Apply segment (secondary) — a flat, borderless cell of the paired
             "Apply → selected / → all" split-control. Neutral TextSecondary at
             rest, lifts to Surface3 + TextPrimary on hover. String Content so the
             glyph/label inherit the button Foreground (and follow the hover swap);
             the shared bordered container + 1px divider make the two read as one
             grouped control. -->
        <Style x:Key="ProfileSegmentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface4Brush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete (muted → danger-on-hover) — lowest-priority action in the
             cluster: a muted ✕ glyph on a plain surface chip at rest, revealing a
             Danger border + Danger glyph only on hover so the destructive intent
             surfaces on approach (never shouts). Tokens only. -->
        <Style x:Key="ProfileDangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSm}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Margin="8"
          AllowDrop="True"
          PreviewDragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />              <!-- 0: header (subtitle + legend) -->
            <RowDefinition Height="*" MinHeight="220" /> <!-- 1: axis-aware preview ‖ list split (T-112) -->
            <RowDefinition Height="Auto" />              <!-- 2: footer (output + Run + lifecycle) -->
        </Grid.RowDefinitions>

        <!-- ================= Header: subtitle + gold/blue legend + cut-profiles bar ================= -->
        <Grid Grid.Row="0" Margin="4,0,4,8">
            <!-- T-142: the subtitle/legend gets its OWN ROW rather than sharing one with the
                 profiles bar. Side by side, the two competed for width and the loser was crushed: an
                 Auto column measures with INFINITE width, so the bar demanded ~1130px, the subtitle's
                 column collapsed, its wrapping text became a one-word-wide sliver many lines tall, and
                 row 0 (Auto) grew until it pushed the whole tab off-screen (T-141). Capping the subtitle
                 at 420px stopped the collapse but left them fighting over a single row and looking
                 cramped. Stacked, neither can starve the other and the MaxWidth crutch is gone. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- subtitle + colour legend, full width -->
                <RowDefinition Height="Auto" />  <!-- profiles bar, full width -->
                <RowDefinition Height="Auto" />  <!-- apply-report note -->
            </Grid.RowDefinitions>

            <!-- Subtitle + gold/blue legend -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <TextBlock Text="Keep the middle · drop intro (gold) &amp; optional outro (blue) · stream-copy, keyframe-snapped · originals kept"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Rectangle Width="12" Height="12" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="intro-end / keep" Margin="4,0,14,0" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <Rectangle Width="12" Height="12" Fill="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="outro-start" Margin="4,0,14,0" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <Rectangle Width="12" Height="12" Fill="{StaticResource DropScrimBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="dropped" Margin="4,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- ===== Cut-profiles cluster (T-103 · regrouped T-113) =====
                 A bordered "Profiles" card that reads as ONE grouped unit (distinct
                 from the tab-strip Add/Clear/Run and the pane's set-at-playhead
                 gestures) with a clear action hierarchy:
                   • HERO   — the thumbnail-aware picker (tallest element, wide MinWidth)
                   • PRIMARY— ✚ Save current as… (accent, the create action)
                   • SECONDARY — Apply → selected / → all as a paired split-control
                   • MUTED  — ✕ Delete (muted, danger-on-hover)
                 Differentiated on ≥2 of size/weight/color-role/spacing, tokens only,
                 and kept compact (one control row under a caption) so it doesn't
                 crowd the split below in either layout mode. HasProfiles gating is
                 unchanged; the empty state stays an unobtrusive Save affordance. -->
            <Border Grid.Row="1"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="10,7"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}">
                <StackPanel>
                    <!-- Section caption — names the grouped unit in both states. -->
                    <TextBlock Text="Profiles"
                               Margin="2,0,0,6"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- T-136: a WrapPanel, not a horizontal StackPanel. A StackPanel neither wraps nor
                         scrolls - it silently CLIPS whatever does not fit off the right edge, and this bar
                         has grown to eight controls while the tab's split is user-resizable (G-039). The
                         set-at-playhead row already uses this idiom. -->
                    <WrapPanel VerticalAlignment="Center">
                        <!-- HERO: the profile BAR (T-161, was a ComboBox).
                             Profiles carry pictures - T-129 and T-135 both exist so a profile can have a
                             recognisable one - and a closed dropdown hid every picture until after you
                             had already chosen by name. A horizontal strip shows them at rest, so
                             choosing is one click on the thing you recognise; "too many profiles"
                             degrades into scrolling instead of a taller and taller popup.

                             Same two bindings the ComboBox used (Profiles / SelectedProfile), so every
                             command, gate and apply action below is untouched. A click SELECTS and
                             nothing more - "Apply to all" rewrites every ticked row's cut points, which
                             must not be one misclick away on a strip you are scrolling.

                             MaxWidth + horizontal scroll is what keeps it from pushing the action
                             buttons off the row: this bar is the ORIGINAL clipping site (T-136). -->
                        <ListBox x:Name="ProfileBar"
                                 MaxWidth="420"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource ProfileItemTemplate}"
                                 ItemContainerStyle="{StaticResource ProfileChipItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ToolTip="Click a saved cut profile to select it, then use Apply to selected / Apply to all"
                                 Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <!-- SECONDARY: Apply as a paired split-control — one bordered
                             Surface2 container, two flat segments split by a 1px rule. -->
                        <Border Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ProfileSegmentButton}"
                                        Content="⧉ Apply to selected"
                                        ToolTip="Apply the chosen profile to the selected row (re-snapped + re-validated)"
                                        Command="{Binding ApplyProfileToSelectedCommand}" />
                                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" />
                                <!-- Primary apply action — SemiBold marks "all" as the emphasised choice
                                     of the pair; relabelled from the terse "⧉ all" so it reads unambiguously
                                     as "apply to all" (T-116). -->
                                <Button Style="{StaticResource ProfileSegmentButton}"
                                        Content="⧉ Apply to all"
                                        FontWeight="SemiBold"
                                        ToolTip="Apply the chosen profile to every checked row (outro measured from the end so uneven lengths align)"
                                        Command="{Binding ApplyProfileToAllCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- T-129: change the selected profile's picture from the ALWAYS-VISIBLE profile
                             bar. The upload/clear pair also lives inside the "Save current as…" popup, but
                             that popup only opens when saving a NEW profile (and is itself gated on
                             CanSaveProfile), so for a user who just wants to re-picture an existing profile
                             the gesture was effectively unreachable — the likeliest reason it read as
                             missing. Reuses the same handler as the popup's button. -->
                        <!-- T-135: capture the frame on screen as this profile's picture. Sits beside the
                             file-picker upload because they do the same job from different sources; the
                             disabled reason is surfaced in the tooltip rather than leaving it inert. -->
                        <Button Style="{StaticResource ProfileSegmentButton}"
                                Content="📷 Use current frame"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding SnapshotProfileThumbnailCommand}"
                                ToolTip="{Binding SnapshotUnavailableReason, TargetNullValue='Make the frame showing in the preview this profile''s thumbnail'}" />

                        <Button Style="{StaticResource ProfileSegmentButton}"
                                Content="🖼 Thumbnail…"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Choose a picture for the selected profile's thumbnail. Save a profile first if none is selected."
                                IsEnabled="{Binding HasSelectedProfile}"
                                Click="OnUploadThumbnailClicked" />

                        <!-- T-139: removal moved here with the rest of the thumbnail editing. It used to
                             live in the save popup, where it acted on the PREVIOUSLY selected profile. -->
                        <Button Style="{StaticResource ProfileSegmentButton}"
                                Content="✕ Picture"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Remove the selected profile's picture (falls back to the placeholder)"
                                IsEnabled="{Binding HasSelectedProfile}"
                                Click="OnClearThumbnailClicked" />

                        <!-- MUTED: Delete — muted ✕, danger-on-hover. -->
                        <Button Style="{StaticResource ProfileDangerButton}"
                                Content="✕"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Delete the selected profile"
                                Command="{Binding DeleteProfileCommand}"
                                Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Empty state: unobtrusive hint next to the always-present Save button -->
                        <TextBlock Text="Save a cut profile"
                                   Margin="2,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding HasProfiles, Converter={StaticResource BoolToCollapsed}}" />

                        <!-- PRIMARY: Save current row's cut as a named profile — accent
                             (the create action), ✚ vector glyph in the app's icon style
                             (matches Split's HeroButton add-cut). Themed inline popup,
                             not a raw dialog. -->
                        <Button x:Name="SaveProfileButton"
                                Style="{StaticResource AccentButton}"
                                Margin="8,0,0,0"
                                Padding="12,5"
                                VerticalAlignment="Center"
                                ToolTip="Save the selected row's current intro/outro as a reusable named profile"
                                IsEnabled="{Binding CanSaveProfile}"
                                Click="OnSaveProfileClicked">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M6,0.5 L6,11.5 M0.5,6 L11.5,6"
                                      Stroke="{StaticResource AccentTextBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="12" Height="12"
                                      VerticalAlignment="Center"
                                      Margin="0,0,7,0"
                                      SnapsToDevicePixels="True"
                                      UseLayoutRounding="True" />
                                <TextBlock Text="Save current as…"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentTextBrush}" />
                            </StackPanel>
                        </Button>

                        <!-- T-147: backup / restore. Profiles already survive an uninstall (the installer
                             deletes nothing under the user profile, asserted by InstallerLeavesUserDataTests),
                             but "survives IF you reinstall on the same machine" is not the same promise as
                             "you can get them back" - a new PC, a wiped disk, or a profile you want to share
                             all need a file. Last in the bar because they are the rarest actions; plain
                             segment styling because neither is destructive on its own (the restore's
                             overwrite decision is gated separately). -->
                        <Button Style="{StaticResource ProfileSegmentButton}"
                                Content="⭳ Back up…"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Save every profile, pictures included, to one file you can keep or move to another PC"
                                Command="{Binding ExportProfilesCommand}" />

                        <Button Style="{StaticResource ProfileSegmentButton}"
                                Content="⭱ Restore…"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Add profiles from a backup file. Profiles you already have are kept unless you say otherwise."
                                Command="{Binding ImportProfilesCommand}" />
                    </WrapPanel>

                    <!-- Themed inline name input (Popup anchored under the Save button) -->
                    <!-- T-138 (second attempt). The first fix released mouse capture on close and did NOT
                         solve it, so the mechanism is removed rather than cleaned up after:

                         StaysOpen="False"      made WPF TAKE mouse capture so it could detect a click
                                                outside. StaysOpen="True" never takes capture at all, so
                                                there is nothing left to dangle. Dismissal is fully ours:
                                                Save, Cancel and Escape all call CloseSaveProfilePopup().
                         AllowsTransparency +   together these make the popup a LAYERED window with a
                         PopupAnimation="Fade"  fade-out. A layered window whose animation does not finish
                                                can sit invisibly over the app swallowing clicks - the same
                                                symptom, by a different route. Neither is load-bearing for
                                                a small name box, so both are gone.

                         Trade-off accepted: clicking outside no longer dismisses. For a box you are typing
                         a name into, not dismissing on a stray click is arguably the better behaviour. -->
                    <Popup x:Name="SaveProfilePopup"
                           PlacementTarget="{Binding ElementName=SaveProfileButton}"
                           Placement="Bottom"
                           StaysOpen="True">
                        <Border Margin="0,4,0,0"
                                Padding="10"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMd}">
                            <StackPanel Width="240">
                                <TextBlock Text="Name this cut profile"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="{StaticResource FontSizeSmall}" />
                                <TextBox x:Name="ProfileNameBox"
                                         Margin="0,6,0,0"
                                         MaxLength="60"
                                         KeyDown="OnProfileNameKeyDown" />

                                <!-- ===== Thumbnail preview + manage (T-107) ===== -->
                                <!-- T-139: the thumbnail controls used to live HERE, and they were bound to
                                     SelectedProfile - which, while a NEW profile is being named, is still the
                                     PREVIOUSLY selected profile. "Clear" therefore wiped a different
                                     profile's picture, silently and unrecoverably. The picture is optional
                                     and set automatically; editing it belongs in the profile bar, where it
                                     acts on the profile actually selected. -->
                                <TextBlock Text="The picture is taken from the intro-end frame automatically. You can change or remove it any time from the profile bar."
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextMutedBrush}" />

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0">
                                    <Button Content="Cancel"
                                            Padding="10,4"
                                            Click="OnCancelSaveProfileClicked" />
                                    <Button Style="{StaticResource AccentButton}"
                                            Content="Save"
                                            Margin="6,0,0,0"
                                            Padding="12,4"
                                            Click="OnConfirmSaveProfileClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Border>

            <!-- Row 2 holds BOTH advisory notes, stacked VERTICALLY. They previously carried
                 Grid.Row="2" each and so painted into the SAME cell: apply-to-all a batch, then drop a
                 folder, and the two notes overdrew — the shorter one hidden entirely, the taller one
                 showing its overhang around it. A vertical StackPanel cannot clip along its stacking
                 axis, so this fixes the collision without renumbering anything. (Found reviewing the
                 T-154 Split/Join mirror, 2026-09-04.) -->
            <StackPanel Grid.Row="2">

                <!-- ===== Apply report note — shared surface for apply-to-all (T-097) + profile apply (T-103) ===== -->
                <Border Margin="0,8,0,0"
                        Padding="8,4"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        Visibility="{Binding ApplyToAllReport, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding ApplyReportSummary}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>

                <!-- T-154: why a drop did not add everything you dropped. The reportable paths are the
                     non-video half of a mixed drop, a file already in the list, a folder, and the same
                     path twice in one payload — from the outside every one looks like a dead drop
                     target, which is how the bug reached us: "why it's work sometime doesn't work some
                     time?" Collapsed when nothing was refused; a message on every drop is noise, and
                     noise is what teaches people to ignore the one that matters.

                     NOT reportable here: a drag holding NO recognised video is refused by OnDragOver
                     before a drop event exists, so this note can never speak for that case (ADR-0023,
                     SPEC-011 I143). The earlier wording claimed it did. -->
                <Border Margin="0,8,0,0"
                        Padding="8,4"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        Visibility="{Binding DropSummary, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding DropSummary}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ★ G-039 / T-112 axis-aware body: the SAME two regions — preview pane + row-list — laid out
             side-by-side (horizontal MODE) or stacked (vertical MODE) from the MainViewModel's IsVertical,
             the natural Bulk analog of Split's video↔tools split. Direct IsVertical bind (NO InverseBool —
             mirrors Split's OUTER panel convention): vertical monitor mode → pane STACKED ABOVE the list;
             horizontal mode → pane BESIDE the list. The OrientedSplitPanel owns the themed splitter + the
             per-axis remembered ratios; those ratios are Bulk-SPECIFIC (BulkHorizontal/BulkVerticalSplitRatio)
             so dragging here never disturbs the Split tab's own split. IsVertical + both ratios come from the
             Window's DataContext (MainViewModel); this UserControl's DataContext stays the BulkCutViewModel.
             The profiles header stays ABOVE (Row 0) and the footer BELOW (Row 2) — outside the split. -->
        <views:OrientedSplitPanel Grid.Row="1"
                                  x:Name="BulkContentArea"
                IsVertical="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=Window}}"
                HorizontalRatio="{Binding DataContext.BulkHorizontalSplitRatio, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                VerticalRatio="{Binding DataContext.BulkVerticalSplitRatio, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
            <views:OrientedSplitPanel.FirstChild>

        <!-- ================= Preview pane (T-101 / G-037) — FirstChild (top / left) =================
             A preview region. When a row is selected it hosts the SAME
             PlayerView the Split tab uses (transport + scrub + hover-thumb + the ±1s/5s/10s/20s/1m/5m
             jog row + frame-step + play/pause + volume/speed + time readout), bound to the ONE shared
             BulkCut.Player (T-100). PlayerView's own OnLoaded attaches the Bulk FfmeMediaPlayer's
             MediaElement via Player.PlayerControl — identical to how Split hosts it — so no attach glue
             is needed here, and the attach re-runs when this pane is re-parented on a layout flip (the
             PlayerView reloads). Below the player, two HeroButton "set at playhead" gestures write the
             selected row's intro-end / outro-start from the live playhead (snapped). A hint fills the
             pane when nothing is selected. -->
        <Border Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}">
            <Grid>
                <!-- Selected: caption + reused player + set-at-playhead action bar -->
                <Grid Margin="8"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />              <!-- caption -->
                        <RowDefinition Height="*" MinHeight="140" /> <!-- reused PlayerView -->
                        <RowDefinition Height="Auto" />              <!-- set-at-playhead action bar -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="2,0,2,6"
                               Text="{Binding SelectedItem.FileName}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SelectedItem.Path}"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <views:PlayerView Grid.Row="1" DataContext="{Binding Player}" />

                    <!-- Set-at-playhead — the pane's primary gesture (HeroButton: gold + Bold + glow,
                         distinct from the AccentButton batch Run). Both disabled until a row is
                         selected AND the player is ready (SetIntro/OutroAtPlayheadCommand guards). -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="▸ play to the intro end (or outro start), then set the cut from the playhead"
                                   Margin="2,0,2,6"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Style="{StaticResource HeroButton}"
                                    Margin="0,0,8,0"
                                    Content="Set intro-end here"
                                    ToolTip="{Binding PrecisionNote}"
                                    Command="{Binding SetIntroAtPlayheadCommand}" />
                            <Button Style="{StaticResource HeroButton}"
                                    Content="Set outro-start here"
                                    ToolTip="{Binding PrecisionNote}"
                                    Command="{Binding SetOutroAtPlayheadCommand}" />
                        </WrapPanel>

                        <!-- T-133: the scope of the two buttons above, stated where they are pressed.
                             ON by default - the tab is called Bulk Cut, and setting one row then pressing
                             Run is what produced "why did it cut only one file?". The outro fans out
                             measured from the END of each file, so one gesture fits uneven lengths. -->
                        <CheckBox Margin="2,8,0,0"
                                  Content="Apply to all ticked videos"
                                  IsChecked="{Binding ApplyCutToAllRows, Mode=TwoWay}"
                                  ToolTip="Set the cut on every ticked video at once. The outro is measured from the end of each file, so videos of different lengths keep the right tail. Turn this off to set only the video you are previewing." />
                        <TextBlock Text="{Binding SetAtPlayheadScopeNote}"
                                   Margin="22,2,2,0"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Hint state — no row selected -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToCollapsed}}">
                    <TextBlock Text="Select a video to preview"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource SansFontFamily}"
                               FontSize="{StaticResource FontSizeTitle}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Click a row below to play it here, then set its intro-end / outro-start from the playhead."
                               Margin="0,4,0,0"
                               MaxWidth="440"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

            </views:OrientedSplitPanel.FirstChild>

        <!-- ================= List of row cards (T-097 / G-038) — SecondChild (bottom / right) =================
             The themed splitter that used to sit between the preview and the list (a fixed GridSplitter)
             is now OWNED by the OrientedSplitPanel and drags in BOTH orientations. The ListBox scrolls
             internally (vertically) so many rows fit while the preview stays fixed. -->
            <views:OrientedSplitPanel.SecondChild>
        <Border Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- T-128: list header — select all / none for the whole item list, mirroring the Split
                     screen's Select all / Select none. Both write the user's INTENT (IsCheckedByUser),
                     never the computed eligibility, so a row with no cut set yet keeps the intent and
                     joins the batch the moment it becomes eligible. -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="8,8,8,0"
                            Visibility="{Binding Items.Count, Converter={StaticResource PositiveCountToVisible}}">
                    <Button Content="Select all"
                            Padding="8,3"
                            Command="{Binding SelectAllItemsCommand}"
                            ToolTip="Tick every video in the list. Ticked rows are the ones Run cuts — and the ones Apply to all / Apply profile write to." />
                    <Button Content="Select none"
                            Margin="6,0,0,0"
                            Padding="8,3"
                            Command="{Binding SelectNoItemsCommand}"
                            ToolTip="Untick every video in the list. Unticked rows are skipped by Run and left alone by Apply to all / Apply profile." />
                    <TextBlock Text="{Binding RunLabel}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <!-- ListBox (T-101): each row is selectable; SelectedItem two-way drives the preview
                     pane above. The ItemContainerStyle drops the default selection chrome for a gold
                     accent ring around the selected card, and carries the inter-card gap (the card's
                     own bottom margin moved here) so the ring hugs the card. The ListBox scrolls
                     internally — no outer ScrollViewer needed. -->
                <ListBox x:Name="RowsList"
                         Grid.Row="1"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="SelBd"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                CornerRadius="{StaticResource RadiusMd}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelBd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BulkItemViewModel}">
                                <Border Padding="8"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}">
                                    <!-- T-127 review finding #6/#8: a row the user has ticked but the app is
                                         still excluding now carries visual weight, not just one more line of
                                         muted grey text. Without this, N ticked checkboxes sit above a
                                         "Run bulk cut (0)" with nothing saying none of them will run. -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExcludedDespiteBeingChecked}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">

                                        <!-- ===== T-116: stable apply-to-all + remove action cluster =====
                                             Docked RIGHT so the DockPanel reserves this cluster's width from
                                             the edge BEFORE laying out the fill content — so the apply-to-all
                                             stays reachable on every row in BOTH layout modes. It used to be
                                             the rightmost Auto column of one wide Grid and clipped off the
                                             right edge in horizontal / narrow-list mode once the T-108
                                             thumbnails + IN/OUT readouts overflowed the (horizontal-scroll-
                                             disabled) list viewport. Compact labels keep the docked width
                                             small so the fill (scrub + thumbnails + readouts) keeps room. -->
                                        <StackPanel DockPanel.Dock="Right"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <!-- Apply this row's cut points to all rows — the primary per-row
                                                 gesture. Keeps the familiar ⧉ glyph (accent) + a short "all"
                                                 label + a strong tooltip so it reads as "apply to all" at a
                                                 glance instead of a mystery icon. Same command + parameter as
                                                 before (no behaviour change). -->
                                            <Button Padding="8,3"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Apply this row's cut points to all rows (overwrites every other row's intro-end / outro-start)"
                                                    Command="{Binding DataContext.ApplyToAllCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⧉"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock Text="all"
                                                               Margin="4,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Remove this row -->
                                            <Button Content="✕"
                                                    Margin="6,0,0,0"
                                                    Padding="7,2"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Remove this video"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                    <!-- FILL: the row's detail content (checkbox · name/keep · scrub ·
                                         cut-point thumbnails · IN/OUT · state chip). ClipToBounds so that when
                                         the list is narrow (horizontal mode) this content clips at its own
                                         right edge instead of overdrawing the docked action cluster above —
                                         the scrub column (the sole `*`) yields first, the detail columns clip
                                         next, and the apply-to-all / remove actions stay put. -->
                                    <Grid ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />   <!-- 0: row-in-batch checkbox -->
                                            <ColumnDefinition Width="210" />    <!-- 1: name + keep-line + warning -->
                                            <ColumnDefinition Width="*" MinWidth="180" /> <!-- 2: dual-handle scrub bar -->
                                            <ColumnDefinition Width="Auto" />   <!-- 3: cut-point frame thumbnails (T-108) -->
                                            <ColumnDefinition Width="Auto" />   <!-- 4: IN / OUT readouts -->
                                            <ColumnDefinition Width="Auto" />   <!-- 5: per-row state chip -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Row-in-batch checkbox. T-127: binds to the user's INTENT, not the
                                             computed eligibility. Binding it to IsEnabled conflated the two,
                                             so a freshly imported (no-op) row read unticked while the intent
                                             was already true and the click could not move it. -->
                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  IsChecked="{Binding IsCheckedByUser, Mode=TwoWay}"
                                                  IsEnabled="{Binding DataContext.CanChangeSelection, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  ToolTip="Include this video in the batch. Also makes it a target for Apply to all / Apply profile." />

                                        <!-- Name + keep-line + warning -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                        Visibility="{Binding KeptDuration, Converter={StaticResource NullToCollapsed}}">
                                                <TextBlock Text="keep " Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="{Binding KeptDuration, Converter={StaticResource Clock}}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text=" → " Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="{Binding OutputPath, Converter={StaticResource FileName}}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Warning}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}" />

                                            <!-- T-127: a row the user has TICKED but the app is still excluding
                                                 says so here. Without this the checkbox reads "in the batch"
                                                 while "Run bulk cut (N)" silently does not count it. -->
                                            <TextBlock Text="{Binding ExclusionReason}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       FontStyle="Italic"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding ExclusionReason, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>

                                        <!-- The view-only dual-handle scrub bar -->
                                        <views:BulkRowScrubView Grid.Column="2"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                DataContext="{Binding}" />

                                        <!-- ===== Cut-point frame thumbnails (T-108) =====
                                             A small frame grabbed at the keyframe-SNAPPED intro-end (gold-ringed)
                                             and, when an outro is set, the outro-start (blue-ringed), so the user
                                             can eyeball where the cut lands without scrubbing. The muted chip is
                                             the placeholder; the Image covers it when a grab resolves, and stays
                                             transparent (chip shows through) while loading / if the grab returned
                                             null. PathToBitmap loads with OnLoad so the temp file isn't held open
                                             (reused verbatim — no second frame-grab path). Updates debounced as
                                             the handle moves. -->
                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0">
                                            <Border Width="64" Height="36"
                                                    Background="{StaticResource Surface2Brush}"
                                                    BorderBrush="{StaticResource AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusSm}"
                                                    ClipToBounds="True"
                                                    SnapsToDevicePixels="True"
                                                    ToolTip="Frame at the intro-end cut">
                                                <Image Source="{Binding IntroThumbnailPath, Converter={StaticResource PathToBitmap}}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <Border Width="64" Height="36"
                                                    Margin="6,0,0,0"
                                                    Background="{StaticResource Surface2Brush}"
                                                    BorderBrush="{StaticResource InfoBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusSm}"
                                                    ClipToBounds="True"
                                                    SnapsToDevicePixels="True"
                                                    ToolTip="Frame at the outro-start cut"
                                                    Visibility="{Binding HasOutro, Converter={StaticResource BoolToVisibility}}">
                                                <Image Source="{Binding OutroThumbnailPath, Converter={StaticResource PathToBitmap}}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                        </StackPanel>

                                        <!-- IN / OUT readouts (editable, snap-on-commit) -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="IN" Width="26" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource TimeField}"
                                                         Tag="intro"
                                                         ToolTip="{Binding IntroEnd.Display}"
                                                         Text="{Binding IntroEnd.Requested, Mode=OneWay, Converter={StaticResource Clock}}"
                                                         KeyDown="OnCutTimeKeyDown"
                                                         LostFocus="OnCutTimeLostFocus" />
                                                <!-- T-119: the snap is never invisible - show where it actually landed. -->
                                                <TextBlock Style="{StaticResource SnapNote}"
                                                           Text="{Binding IntroEnd.SnapNote}"
                                                           ToolTip="{Binding IntroEnd.Display}"
                                                           Visibility="{Binding IntroEnd.HasSnapNote, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="OUT" Width="26" Style="{StaticResource FieldLabel}" />
                                                <!-- Outro present: editable field + clear affordance -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding HasOutro, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBox Style="{StaticResource TimeField}"
                                                             Tag="outro"
                                                             ToolTip="{Binding OutroStart.Display}"
                                                             Text="{Binding OutroStart.Requested, Mode=OneWay, Converter={StaticResource Clock}}"
                                                             KeyDown="OnCutTimeKeyDown"
                                                             LostFocus="OnCutTimeLostFocus" />
                                                    <TextBlock Style="{StaticResource SnapNote}"
                                                               Text="{Binding OutroStart.SnapNote}"
                                                               ToolTip="{Binding OutroStart.Display}"
                                                               Visibility="{Binding OutroStart.HasSnapNote, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="✕"
                                                            Margin="4,0,0,0"
                                                            Padding="5,0"
                                                            ToolTip="Remove the outro (keep runs to end)"
                                                            Click="OnClearOutroClicked" />
                                                </StackPanel>
                                                <!-- No outro: hint + add affordance -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding HasOutro, Converter={StaticResource BoolToCollapsed}}">
                                                    <TextBlock Text="— end —" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                                    <Button Content="+ outro"
                                                            Margin="6,0,0,0"
                                                            Padding="6,0"
                                                            ToolTip="Add an outro-start handle to also trim the tail"
                                                            Click="OnAddOutroClicked" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Per-row state chip -->
                                        <Border Grid.Column="5"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"
                                                Padding="8,2"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Background="{StaticResource Surface2Brush}"
                                                BorderThickness="1"
                                                BorderBrush="{Binding RowState, Converter={StaticResource RowState}, ConverterParameter=brush}">
                                            <TextBlock Text="{Binding RowState, Converter={StaticResource RowState}, ConverterParameter=label}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{Binding RowState, Converter={StaticResource RowState}, ConverterParameter=brush}" />
                                        </Border>

                                    </Grid>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state (Join-style hint + gold/blue legend) — shown while there are no rows. -->
                <Border Grid.Row="1"
                        IsHitTestVisible="False"
                        Background="Transparent"
                        Visibility="{Binding Items.Count, Converter={StaticResource EmptyCountToVisible}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="No videos to trim"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource SansFontFamily}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Add or drop videos here, mark intro-end (and optional outro-start), or set one and apply to all."
                                   Margin="0,4,0,0"
                                   MaxWidth="440"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Rectangle Width="12" Height="12" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="intro-end / keep" Margin="4,0,14,0" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <Rectangle Width="12" Height="12" Fill="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="outro-start" Margin="4,0,0,0" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
            </views:OrientedSplitPanel.SecondChild>
        </views:OrientedSplitPanel>

        <!-- ================= Footer: output note + overall bar + Run/Cancel + lifecycle surfaces ================= -->
        <StackPanel Grid.Row="2" Margin="4,10,4,0">
            <!-- T-160: TWO rows, not one. Every ticket that added an output option added it to the
                 single footer row, which reached eight interactive controls and three conditional
                 notes. T-156's WrapPanel stopped them CLIPPING, but wrapping inside a `*` column that
                 is squeezed between two `Auto` columns just reflows them into a narrow ragged block
                 while RunScopeSummary wraps in its own column at the same time. Both are correct
                 alone and cramped together. Giving the options the full width costs one row that
                 wrapping was already consuming, and lets Run keep a row to itself. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- 0: output options, full width -->
                    <RowDefinition Height="Auto" />  <!-- 1: the actions - destructive | spacer | Run -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- 0: the destructive post-run action, alone, at the far left (T-146).
                         It gets its OWN column rather than a slot in a StackPanel because
                         HorizontalAlignment is inert along a StackPanel's stacking axis - the
                         first attempt set HorizontalAlignment="Left" on a button that was still
                         laid out immediately after Run, and it did nothing. -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- T-144/T-146: "Delete originals" - the only irreversible control in the footer.
                     Hidden until it can do something (a permanently greyed destructive button just
                     trains people to ignore it), styled in the tab's existing danger vocabulary
                     (muted at rest, danger on hover), and placed at the OPPOSITE END from Run.

                     The placement is the point, and the first attempt got it wrong in a way worth
                     recording: the button was appended AFTER Run inside Run's horizontal StackPanel
                     with HorizontalAlignment="Left", which a StackPanel ignores on its stacking axis.
                     The result was the exact hazard the ticket set out to avoid - when a batch
                     finished, Run shifted left and this button appeared on the pixels Run had just
                     occupied, under the cursor of someone pressing Run repeatedly. Its own column
                     makes the separation structural instead of advisory. -->
                <Button Grid.Row="1"
                        Grid.Column="0"
                        x:Name="DeleteOriginalsButton"
                        Style="{StaticResource ProfileDangerButton}"
                        Content="{Binding DeleteOriginalsLabel}"
                        Margin="0,0,28,0"
                        VerticalAlignment="Center"
                        Command="{Binding DeleteOriginalsCommand}"
                        ToolTip="Send the originals of successfully trimmed videos to the Recycle Bin. Skips anything that failed, and anything whose trimmed file is missing. Nothing is deleted permanently."
                        Visibility="{Binding CanDeleteOriginals, Converter={StaticResource BoolToVisibility}}" />

                <!-- T-156: a WrapPanel, not a horizontal StackPanel. Two more options pushed this row
                     past the window width and a StackPanel CLIPS rather than wraps — the destructive
                     "Replace originals" and both new checkboxes simply vanished off the right edge at
                     1280px. Exactly the failure T-136 fixed in the profile bar and T-141 in the header;
                     third time, so it is now pinned by a layout test. -->
                <!-- T-160: grouped by CONSEQUENCE, in reading order - output, then precision, then the
                     three destructive controls together at the end. Previously the danger-coloured
                     options were interleaved with the neutral ones (the armed-state note sat between
                     "Exact cut" and "Auto-delete"), so the red vocabulary was scattered across the row
                     and nothing read as a block. A 1px rule separates the groups. Still a WrapPanel,
                     never a horizontal StackPanel - a StackPanel CLIPS rather than wraps, which is the
                     T-136 / T-141 / T-156 failure this row already shipped once. -->
                <WrapPanel x:Name="FooterOptions"
                           Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,0,0,10"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">

                    <!-- ===== Group 1: where the output goes ===== -->
                    <!-- T-123: the note is bound, never hard-coded, so it can never contradict the mode. -->
                    <TextBlock Text="{Binding OutputNote}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <!-- Collision policy: inert (greyed) while replace-original owns the destination. -->
                    <CheckBox Content="Overwrite existing output"
                              Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding Overwrite, Mode=TwoWay}"
                              IsEnabled="{Binding CollisionIsInert, Converter={StaticResource InverseBool}}"
                              ToolTip="Ignored while &quot;Replace originals&quot; is on — the destination is the source file." />

                    <Rectangle Width="1"
                               Height="16"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Fill="{StaticResource BorderBrush}" />

                    <!-- ===== Group 2: how the cut is made ===== -->
                    <!-- T-125: cut precision. Default (unchecked) keeps the lossless identity. -->
                    <CheckBox Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              Content="Exact cut"
                              IsChecked="{Binding ExactCut, Mode=TwoWay}"
                              ToolTip="Cut exactly where you set the handles instead of snapping to the nearest keyframe. Re-encodes about a second of video per cut; the rest is still copied untouched." />
                    <TextBlock Text="{Binding PrecisionNote}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{StaticResource FontSizeSmall}" />

                    <Rectangle Width="1"
                               Height="16"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Fill="{StaticResource BorderBrush}" />

                    <!-- ===== Group 3: the irreversible ones, together =====
                         Each is deliberately NOT a look-alike peer of the neutral checkboxes above -
                         danger colour-role + warning glyph + bold weight (three differentiators). -->
                    <CheckBox Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding ReplaceOriginal, Mode=TwoWay}"
                              ToolTip="Write each trimmed result OVER its original file. Replaced originals go to the Recycle Bin. You will be asked to confirm before the batch runs.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" Margin="0,0,5,0" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="Replace originals"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </CheckBox>

                    <!-- T-156: reclaim space without two manual steps after every batch. Both default
                         OFF; the second is disabled until the first is on (emptying the bin frees
                         nothing this app put there otherwise), and arming it asks once because the pair
                         is permanent deletion with no undo. -->
                    <CheckBox Margin="18,0,0,0"
                              VerticalAlignment="Center"
                              Content="Auto-delete originals"
                              IsChecked="{Binding AutoDeleteOriginals, Mode=TwoWay}"
                              ToolTip="After a batch finishes with no failures, send each original to the Recycle Bin automatically. A partly-failed batch never deletes anything." />

                    <CheckBox Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding CanAutoEmptyRecycleBin}"
                              IsChecked="{Binding AutoEmptyRecycleBin, Mode=TwoWay}"
                              ToolTip="Also empty the Recycle Bin, so the space is actually freed. This makes the deletion PERMANENT and unrecoverable, and empties the whole bin — including files this app never touched.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" Margin="0,0,5,0" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="and empty bin"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </CheckBox>

                    <!-- T-156: the armed state must be visible BEFORE Run is pressed, not discovered
                         after a batch has already deleted something. T-160 moved it to the END of the
                         destructive group - it summarises what the two boxes above just armed, so it
                         belongs after them rather than between the neutral options and them. -->
                    <TextBlock Text="{Binding DestructiveOutputNote}"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Visibility="{Binding DestructiveOutputNote, Converter={StaticResource NullToCollapsed}}" />
                </WrapPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                    <!-- T-134: what Run will actually do, said BEFORE it is pressed. The count was already
                         on the button and it was still not enough - a user imported a batch, set one cut,
                         pressed Run, got one file, and had to ask why. Hidden entirely when every row will
                         run, so it is never noise. Warning-coloured only when rows the user TICKED are
                         being excluded; rows they unticked themselves stay calm. -->
                    <TextBlock Text="{Binding RunScopeSummary}"
                               MaxWidth="340"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Right"
                               FontSize="{StaticResource FontSizeSmall}"
                               Visibility="{Binding RunScopeSummary, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RunScopeIsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button x:Name="RunBatchButton"
                            Style="{StaticResource AccentButton}"
                            Content="{Binding RunLabel}"
                            Padding="16,6"
                            Command="{Binding RunBatchCommand}" />
                    <Button Content="Cancel"
                            Margin="6,0,0,0"
                            Padding="10,5"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding Operation.CanCancel, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>

            <ProgressBar Height="16"
                         Margin="0,10,0,0"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="{Binding Operation.IsIndeterminate, Mode=OneWay}"
                         Value="{Binding Operation.Progress, Mode=OneWay, Converter={StaticResource FractionToPercent}}"
                         Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}" />

            <!-- Running status + ETA -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,6,0,0"
                        Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding Operation.StatusText}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding Operation.EtaText}"
                           Visibility="{Binding Operation.EtaText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>

            <!-- COMPLETED surface (green ✓ + summary + Open folder) -->
            <Border Margin="0,8,0,0"
                    Padding="8"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource OkBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Visibility="{Binding Operation.IsCompleted, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✓"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontWeight="Bold"
                               Foreground="{StaticResource OkBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding Operation.ResultSummary}" />
                    <Button Content="Open folder"
                            Margin="10,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            ToolTip="Reveal the output folder in Explorer"
                            Click="OnOpenFolderClicked" />
                </StackPanel>
            </Border>

            <!-- FAILED-SOME surface: list of failed rows (jump-links + per-row copy/log) + Retry failed (N) -->
            <Border Margin="0,8,0,0"
                    Padding="8"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Visibility="{Binding FailedCount, Converter={StaticResource PositiveCountToVisible}}">
                <StackPanel>
                    <TextBlock Text="Some videos failed — fix and retry."
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" />
                    <ItemsControl ItemsSource="{Binding LastFailedItems}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type bulk:BulkTrimItemResult}">
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Item.Tag.FileName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Error.Message}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Jump" Padding="8,1" Margin="6,0,0,0"
                                            ToolTip="Scroll to this row" Click="OnJumpToFailedClicked" />
                                    <Button Grid.Column="2" Content="Copy error" Padding="8,1" Margin="6,0,0,0"
                                            Click="OnCopyFailedErrorClicked" />
                                    <Button Grid.Column="3" Content="Log" Padding="8,1" Margin="6,0,0,0"
                                            ToolTip="Reveal the saved full log"
                                            Click="OnOpenFailedLogClicked" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding FailedCount, StringFormat='Retry failed ({0})'}"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            ToolTip="Re-run the batch to retry the failed videos"
                            Command="{Binding RunBatchCommand}" />
                </StackPanel>
            </Border>

            <!-- CANCELLED surface (neutral, not error-red) -->
            <Border Margin="0,8,0,0"
                    Padding="8"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Visibility="{Binding Operation.IsCancelled, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Cancelled"
                           FontFamily="{StaticResource MonoFontFamily}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </Border>

            <!-- ERROR surface (batch-level failure, e.g. disk pre-flight blocked) -->
            <Border Margin="0,6,0,0"
                    Padding="8"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Visibility="{Binding Operation.Error, Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="{Binding Operation.Error.Message}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Operation.Error.Hint}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Visibility="{Binding Operation.Error.Hint, Converter={StaticResource NullToCollapsed}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Copy error"
                                Padding="8,2"
                                ToolTip="Copy the full error (message + full log) to the clipboard"
                                Click="OnCopyErrorClicked" />
                        <Button Content="Open log file"
                                Margin="6,0,0,0"
                                Padding="8,2"
                                ToolTip="Reveal the saved full log in Explorer"
                                Click="OnOpenLogClicked"
                                Visibility="{Binding Operation.Error.HasLogFile, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= Drag-drop highlight overlay ================= -->
        <Border x:Name="DropHighlight"
                Grid.RowSpan="3"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="3"
                Background="{StaticResource AccentMutedBrush}"
                CornerRadius="{StaticResource RadiusSm}" />
    </Grid>
</UserControl>
