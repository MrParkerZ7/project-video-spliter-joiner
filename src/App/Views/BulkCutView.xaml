<UserControl x:Class="VideoSplitJoiner.App.Views.BulkCutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:views="clr-namespace:VideoSplitJoiner.App.Views"
             xmlns:vm="clr-namespace:VideoSplitJoiner.App.ViewModels"
             xmlns:bulk="clr-namespace:VideoSplitJoiner.Core.Bulk;assembly=VideoSplitJoiner.Core">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
        <conv:FractionToPercentConverter x:Key="FractionToPercent" />
        <conv:ClockConverter x:Key="Clock" />
        <conv:FileNameConverter x:Key="FileName" />
        <conv:EmptyCountToVisibleConverter x:Key="EmptyCountToVisible" />
        <conv:PositiveCountToVisibleConverter x:Key="PositiveCountToVisible" />
        <conv:RowStateConverter x:Key="RowState" />

        <!-- Small mono field label. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Small mono editable time field for the IN/OUT readouts. -->
        <Style x:Key="TimeField" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Width" Value="82" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Margin="8"
          AllowDrop="True"
          PreviewDragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header: subtitle + gold/blue legend ================= -->
        <StackPanel Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="Keep the middle · drop intro (gold) &amp; optional outro (blue) · stream-copy, keyframe-snapped · originals kept"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Rectangle Width="12" Height="12" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="intro-end / keep" Margin="4,0,14,0" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Rectangle Width="12" Height="12" Fill="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                <TextBlock Text="outro-start" Margin="4,0,14,0" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Rectangle Width="12" Height="12" Fill="{StaticResource DropScrimBrush}" VerticalAlignment="Center" />
                <TextBlock Text="dropped" Margin="4,0,0,0" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- ================= List of row cards ================= -->
        <Border Grid.Row="1"
                Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="8">
                    <ItemsControl x:Name="RowsList" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BulkItemViewModel}">
                                <Border Margin="0,0,0,8"
                                        Padding="8"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Row-in-batch checkbox -->
                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  ToolTip="Include this video in the batch" />

                                        <!-- Name + keep-line + warning -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                        Visibility="{Binding KeptDuration, Converter={StaticResource NullToCollapsed}}">
                                                <TextBlock Text="keep " Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="{Binding KeptDuration, Converter={StaticResource Clock}}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text=" → " Style="{StaticResource FieldLabel}" />
                                                <TextBlock Text="{Binding OutputPath, Converter={StaticResource FileName}}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Warning}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>

                                        <!-- The view-only dual-handle scrub bar -->
                                        <views:BulkRowScrubView Grid.Column="2"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                DataContext="{Binding}" />

                                        <!-- IN / OUT readouts (editable, snap-on-commit) -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="IN" Width="26" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource TimeField}"
                                                         Tag="intro"
                                                         ToolTip="{Binding IntroEnd.Display}"
                                                         Text="{Binding IntroEnd.Snapped, Mode=OneWay, Converter={StaticResource Clock}}"
                                                         KeyDown="OnCutTimeKeyDown"
                                                         LostFocus="OnCutTimeLostFocus" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="OUT" Width="26" Style="{StaticResource FieldLabel}" />
                                                <!-- Outro present: editable field + clear affordance -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding HasOutro, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBox Style="{StaticResource TimeField}"
                                                             Tag="outro"
                                                             ToolTip="{Binding OutroStart.Display}"
                                                             Text="{Binding OutroStart.Snapped, Mode=OneWay, Converter={StaticResource Clock}}"
                                                             KeyDown="OnCutTimeKeyDown"
                                                             LostFocus="OnCutTimeLostFocus" />
                                                    <Button Content="✕"
                                                            Margin="4,0,0,0"
                                                            Padding="5,0"
                                                            ToolTip="Remove the outro (keep runs to end)"
                                                            Click="OnClearOutroClicked" />
                                                </StackPanel>
                                                <!-- No outro: hint + add affordance -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding HasOutro, Converter={StaticResource BoolToCollapsed}}">
                                                    <TextBlock Text="— end —" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                                    <Button Content="+ outro"
                                                            Margin="6,0,0,0"
                                                            Padding="6,0"
                                                            ToolTip="Add an outro-start handle to also trim the tail"
                                                            Click="OnAddOutroClicked" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Per-row state chip -->
                                        <Border Grid.Column="4"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"
                                                Padding="8,2"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Background="{StaticResource Surface2Brush}"
                                                BorderThickness="1"
                                                BorderBrush="{Binding RowState, Converter={StaticResource RowState}, ConverterParameter=brush}">
                                            <TextBlock Text="{Binding RowState, Converter={StaticResource RowState}, ConverterParameter=label}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{Binding RowState, Converter={StaticResource RowState}, ConverterParameter=brush}" />
                                        </Border>

                                        <!-- Apply this row's cut points to all others (source = this row) -->
                                        <Button Grid.Column="5"
                                                Content="⧉"
                                                Margin="0,0,4,0"
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                ToolTip="Apply this row's cut points to every other row"
                                                Command="{Binding DataContext.ApplyToAllCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />

                                        <!-- Remove this row -->
                                        <Button Grid.Column="6"
                                                Content="✕"
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                ToolTip="Remove this video"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state (Join-style hint + gold/blue legend) — shown while there are no rows. -->
                <Border IsHitTestVisible="False"
                        Background="Transparent"
                        Visibility="{Binding Items.Count, Converter={StaticResource EmptyCountToVisible}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="No videos to trim"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource SansFontFamily}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Add or drop videos here, mark intro-end (and optional outro-start), or set one and apply to all."
                                   Margin="0,4,0,0"
                                   MaxWidth="440"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Rectangle Width="12" Height="12" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="intro-end / keep" Margin="4,0,14,0" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <Rectangle Width="12" Height="12" Fill="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="outro-start" Margin="4,0,0,0" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= Footer: output note + overall bar + Run/Cancel + lifecycle surfaces ================= -->
        <StackPanel Grid.Row="2" Margin="4,10,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Output → same folder · _trimmed suffix · originals kept"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <CheckBox Content="Overwrite existing output"
                              Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding Overwrite, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}"
                            Content="{Binding RunLabel}"
                            Padding="16,6"
                            Command="{Binding RunBatchCommand}" />
                    <Button Content="Cancel"
                            Margin="6,0,0,0"
                            Padding="10,5"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding Operation.CanCancel, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>

            <ProgressBar Height="16"
                         Margin="0,10,0,0"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="{Binding Operation.IsIndeterminate, Mode=OneWay}"
                         Value="{Binding Operation.Progress, Mode=OneWay, Converter={StaticResource FractionToPercent}}"
                         Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}" />

            <!-- Running status + ETA -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,6,0,0"
                        Visibility="{Binding Operation.IsRunning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding Operation.StatusText}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding Operation.EtaText}"
                           Visibility="{Binding Operation.EtaText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>

            <!-- COMPLETED surface (green ✓ + summary + Open folder) -->
            <Border Margin="0,8,0,0"
                    Padding="8"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource OkBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Visibility="{Binding Operation.IsCompleted, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✓"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontWeight="Bold"
                               Foreground="{StaticResource OkBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding Operation.ResultSummary}" />
                    <Button Content="Open folder"
                            Margin="10,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            ToolTip="Reveal the output folder in Explorer"
                            Click="OnOpenFolderClicked" />
                </StackPanel>
            </Border>

            <!-- FAILED-SOME surface: list of failed rows (jump-links + per-row copy/log) + Retry failed (N) -->
            <Border Margin="0,8,0,0"
                    Padding="8"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Visibility="{Binding FailedCount, Converter={StaticResource PositiveCountToVisible}}">
                <StackPanel>
                    <TextBlock Text="Some videos failed — fix and retry."
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" />
                    <ItemsControl ItemsSource="{Binding LastFailedItems}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type bulk:BulkTrimItemResult}">
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Item.Tag.FileName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Error.Message}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Jump" Padding="8,1" Margin="6,0,0,0"
                                            ToolTip="Scroll to this row" Click="OnJumpToFailedClicked" />
                                    <Button Grid.Column="2" Content="Copy error" Padding="8,1" Margin="6,0,0,0"
                                            Click="OnCopyFailedErrorClicked" />
                                    <Button Grid.Column="3" Content="Log" Padding="8,1" Margin="6,0,0,0"
                                            ToolTip="Reveal the saved full log"
                                            Click="OnOpenFailedLogClicked" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding FailedCount, StringFormat='Retry failed ({0})'}"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            ToolTip="Re-run the batch to retry the failed videos"
                            Command="{Binding RunBatchCommand}" />
                </StackPanel>
            </Border>

            <!-- CANCELLED surface (neutral, not error-red) -->
            <Border Margin="0,8,0,0"
                    Padding="8"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Visibility="{Binding Operation.IsCancelled, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Cancelled"
                           FontFamily="{StaticResource MonoFontFamily}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </Border>

            <!-- ERROR surface (batch-level failure, e.g. disk pre-flight blocked) -->
            <Border Margin="0,6,0,0"
                    Padding="8"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Visibility="{Binding Operation.Error, Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="{Binding Operation.Error.Message}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Operation.Error.Hint}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Visibility="{Binding Operation.Error.Hint, Converter={StaticResource NullToCollapsed}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Copy error"
                                Padding="8,2"
                                ToolTip="Copy the full error (message + full log) to the clipboard"
                                Click="OnCopyErrorClicked" />
                        <Button Content="Open log file"
                                Margin="6,0,0,0"
                                Padding="8,2"
                                ToolTip="Reveal the saved full log in Explorer"
                                Click="OnOpenLogClicked"
                                Visibility="{Binding Operation.Error.HasLogFile, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= Drag-drop highlight overlay ================= -->
        <Border x:Name="DropHighlight"
                Grid.RowSpan="3"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="3"
                Background="{StaticResource AccentMutedBrush}"
                CornerRadius="{StaticResource RadiusSm}" />
    </Grid>
</UserControl>
